---
import isologo from "~/assets/marca/isologo.svg?raw";
import { waLink } from "~/lib/contacto";

interface Props { unidadActiva?: string }
const { unidadActiva } = Astro.props;

const enlaces = [
  { id: "restaurante", texto: "Restaurante", href: "/restaurante" },
  { id: "hotel", texto: "Hotel", href: "/hotel" },
  { id: "balneario", texto: "Balneario", href: "/balneario" },
  { id: "eventos", texto: "Eventos", href: "/eventos" },
  { id: "galeria", texto: "Galería", href: "/galeria" },
  { id: "contacto", texto: "Contacto", href: "/contacto" },
];
const wa = await waLink("general");
const enGiftcard = Astro.url.pathname.replace(/\/$/, "") === "/giftcard";

/* El moño de regalo del botón de gift card: trazo, para que tome el color
   de la letra. */
const regalo = `<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect x="3" y="8" width="18" height="4" rx="1"/><path d="M12 8v13"/><path d="M19 12v7a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2v-7"/><path d="M7.5 8a2.5 2.5 0 0 1 0-5C10 3 12 8 12 8s2-5 4.5-5a2.5 2.5 0 0 1 0 5"/></svg>`;
---

<header class="cabecera">
  <a href="/" class="logo" aria-label="Mirador Waikiki, inicio">
    <span set:html={isologo} />
  </a>

  <!-- Gift card: botón propio, dorado y con un brillo que pasa cada tanto,
       para que se distinga de «Reservar» y del menú. En el celular queda
       sólo el moño (el texto completo va destacado dentro del menú). -->
  <a
    class="regalo"
    href="/giftcard"
    aria-current={enGiftcard ? "page" : undefined}
  >
    <span class="regalo-icono" set:html={regalo} />
    <span class="regalo-texto">Gift card</span>
    <span class="solo-lector">Gift card: regalá una salida frente al mar</span>
  </a>

  <a class="reservar" href={wa} target="_blank" rel="noopener">Reservar</a>

  <!-- En pantalla angosta el menú se pliega. Con <details> funciona sin
       JavaScript y el teclado lo abre y cierra como cualquier control. -->
  <details class="menu">
    <summary aria-label="Abrir el menú de secciones">
      <span class="barras" aria-hidden="true"><i></i><i></i><i></i></span>
      <span class="rotulo">Menú</span>
    </summary>
    <nav aria-label="Secciones del complejo">
      <ul>
        <li class="li-regalo" style="--i: 0">
          <a href="/giftcard" class="destacado" aria-current={enGiftcard ? "page" : undefined}>
            <span class="regalo-icono" set:html={regalo} />
            <span>
              Gift card
              <small>Regalá una salida frente al mar</small>
            </span>
          </a>
        </li>
        {
          enlaces.map((e, i) => (
            <li style={`--i: ${i + 1}`}>
              <a
                href={e.href}
                class:list={[`u-${e.id}`, { activo: unidadActiva === e.id }]}
                aria-current={unidadActiva === e.id ? "page" : undefined}
              >
                {e.texto}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </details>
</header>

<style>
  /* La cabecera va encima de la foto del primer bloque, como vidrio
     esmerilado: la imagen se ve a través, desenfocada. Todas las páginas
     arrancan con foto, así que siempre hay algo lindo detrás. La
     transparencia sale de medir: la letra oscura tiene que leerse aunque
     detrás haya una parte oscura de la foto. */
  .cabecera {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    z-index: var(--z-fijo);
    display: grid;
    grid-template-columns: auto 1fr auto auto auto;
    align-items: center;
    gap: clamp(0.6rem, 2vw, 1.5rem);
    min-height: var(--alto-cabecera);
    padding: 0.65rem var(--margen);
    background: rgb(235 228 209 / var(--cabecera-alfa));
    -webkit-backdrop-filter: blur(14px) saturate(1.2);
    backdrop-filter: blur(14px) saturate(1.2);
    border-bottom: 1px solid rgb(255 255 255 / 0.35);
  }
  @supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
    .cabecera { background: rgb(235 228 209 / 0.94); }
  }

  .logo {
    grid-area: 1 / 1;
    display: flex;
    color: var(--tinta);
  }
  .logo :global(svg) {
    height: clamp(34px, 3.4vw, 46px);
    width: auto;
  }

  .reservar {
    grid-area: 1 / 4;
    display: inline-flex;
    align-items: center;
    min-height: var(--toque);
    padding: 0 1.25rem;
    background: var(--accion-fondo);
    color: var(--accion-tinta);
    border: 1px solid var(--accion-borde);
    border-radius: 999px;
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    text-decoration: none;
    transition: background-color 0.25s, color 0.25s, border-color 0.25s;
  }
  .reservar:hover {
    background: var(--accion-hover-fondo);
    color: var(--accion-hover-tinta);
    border-color: var(--accion-hover-fondo);
  }

  .menu { grid-area: 1 / 5; }

  /* ── Gift card ───────────────────────────────────────────────────────
     Dorado arena con la letra oscura (contraste 8:1) y un brillo que cruza
     el botón cada pocos segundos. En el celular es un círculo con el moño. */
  .regalo {
    grid-area: 1 / 3;
    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    min-width: var(--toque);
    min-height: var(--toque);
    padding: 0;
    border-radius: 999px;
    background: linear-gradient(135deg, #e6d6aa 0%, #cab892 55%, #d9c591 100%);
    border: 1px solid rgb(255 255 255 / 0.7);
    box-shadow: 0 4px 14px rgb(140 112 60 / 0.28), inset 0 1px 0 rgb(255 255 255 / 0.6);
    color: var(--tinta);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    text-decoration: none;
    transition: transform 0.25s var(--curva), box-shadow 0.25s;
  }
  .regalo::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(105deg, transparent 30%, rgb(255 255 255 / 0.75) 50%, transparent 70%);
    transform: translateX(-120%);
    animation: brillo 5.5s ease-in-out 1.2s infinite;
  }
  .regalo:hover {
    transform: translateY(-1px);
    box-shadow: 0 8px 20px rgb(140 112 60 / 0.35), inset 0 1px 0 rgb(255 255 255 / 0.6);
  }
  .regalo[aria-current="page"] { box-shadow: 0 0 0 2px var(--tinta), inset 0 1px 0 rgb(255 255 255 / 0.6); }
  .regalo-icono { display: inline-flex; }
  .regalo-icono :global(svg) { animation: latido 5.5s ease-in-out 1.2s infinite; }
  .regalo-texto { display: none; }
  @keyframes brillo {
    0%, 62% { transform: translateX(-120%); }
    80%, 100% { transform: translateX(120%); }
  }
  @keyframes latido {
    0%, 62%, 100% { transform: none; }
    68% { transform: rotate(-12deg) scale(1.12); }
    74% { transform: rotate(10deg) scale(1.12); }
    80% { transform: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .regalo::after, .regalo-icono :global(svg) { animation: none; }
    .regalo { transition: none; }
  }
  .solo-lector {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  /* En el menú del celular, primero y destacado. */
  .menu nav a.destacado {
    gap: 0.75rem;
    margin: 0.5rem 0 0.25rem;
    padding: 0.7rem 0.9rem;
    border: 1px solid #cab892;
    border-radius: var(--radio);
    background: linear-gradient(135deg, #efe4c6 0%, #e2d2a6 100%);
    color: var(--tinta);
    font-weight: 600;
    line-height: 1.25;
  }
  .menu nav a.destacado small {
    display: block;
    font-size: 0.82rem;
    font-weight: 400;
    color: var(--tinta-suave);
  }
  .menu nav a.destacado .regalo-icono {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 50%;
    background: rgb(255 255 255 / 0.6);
  }

  summary {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: var(--toque);
    padding: 0 0.6rem;
    font-size: 0.875rem;
    font-weight: 600;
    list-style: none;
  }
  summary::-webkit-details-marker { display: none; }
  .barras { display: grid; gap: 4px; }
  .barras i {
    display: block;
    width: 20px;
    height: 2px;
    border-radius: 2px;
    background: currentColor;
    transition: transform 320ms var(--curva), opacity 200ms ease;
  }
  /* Abierto, las tres rayas se cruzan en una X. Las de afuera están a 6 px
     del centro (2 de alto + 4 de separación). */
  .menu[open]:not(.cerrando) .barras i:nth-child(1) { transform: translateY(6px) rotate(45deg); }
  .menu[open]:not(.cerrando) .barras i:nth-child(2) { opacity: 0; transform: scaleX(0.4); }
  .menu[open]:not(.cerrando) .barras i:nth-child(3) { transform: translateY(-6px) rotate(-45deg); }
  .rotulo { display: none; }

  /* Panel plegado: ocupa el ancho completo debajo de la barra. */
  .menu nav {
    position: absolute;
    left: 0;
    right: 0;
    z-index: var(--z-flotante);
    background: var(--fondo);
    border-bottom: 1px solid var(--linea);
    box-shadow: var(--elev-3);
  }
  /* Animación del panel en angosto: baja y aparece; los links detrás, de a
     uno. Al cerrar se pliega hacia arriba (la clase .cerrando la pone el
     script, que espera a que termine antes de cerrar el <details>). */
  @media (max-width: 879px) {
    .menu[open] nav { animation: desplegar 340ms var(--curva) both; }
    .menu[open] nav li {
      animation: asomar 420ms var(--curva) both;
      animation-delay: calc(80ms + var(--i, 0) * 45ms);
    }
    .menu.cerrando nav { animation: plegar 220ms var(--curva) both; }
    .menu.cerrando nav li { animation: none; }
  }
  @keyframes desplegar {
    from { opacity: 0; transform: translateY(-12px); clip-path: inset(0 0 100% 0); }
    to { opacity: 1; transform: none; clip-path: inset(0 0 0 0); }
  }
  @keyframes asomar {
    from { opacity: 0; transform: translateY(-8px); }
    to { opacity: 1; transform: none; }
  }
  @keyframes plegar {
    from { opacity: 1; transform: none; clip-path: inset(0 0 0 0); }
    to { opacity: 0; transform: translateY(-10px); clip-path: inset(0 0 100% 0); }
  }
  @media (prefers-reduced-motion: reduce) {
    .menu[open] nav, .menu[open] nav li, .menu.cerrando nav { animation: none; }
    .barras i { transition: none; }
  }
  .menu ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    padding: 0.25rem var(--margen) 0.75rem;
  }
  .menu nav a {
    display: flex;
    align-items: center;
    min-height: 3.25rem;
    font-size: 1.0625rem;
    font-weight: 500;
    text-decoration: none;
    border-bottom: 1px solid var(--linea);
  }
  .menu nav li:last-child a { border-bottom: 0; }
  .menu nav a.activo { font-weight: 700; color: var(--u-txt, var(--tinta)); }

  /* A partir de acá el menú es una barra horizontal y el botón desaparece. */
  @media (min-width: 880px) {
    .cabecera { grid-template-columns: auto 1fr auto auto; }
    .menu { grid-area: 1 / 2; }
    summary { display: none; }
    .regalo { grid-area: 1 / 3; }
    .reservar { grid-area: 1 / 4; }
    /* El renglón destacado es del menú del celular; en la barra ancha ya
       está el botón. */
    .li-regalo { display: none; }

    .menu nav {
      position: static;
      background: none;
      border: 0;
      /* La sombra es del panel desplegable del celular; en la barra ancha
         dibujaba un rectángulo detrás de los links. */
      box-shadow: none;
    }
    .menu ul {
      flex-direction: row;
      justify-content: flex-end;
      gap: clamp(0.9rem, 1.8vw, 1.7rem);
      padding: 0;
    }
    .menu nav a {
      min-height: var(--toque);
      font-size: 0.9375rem;
      border-bottom: 2px solid transparent;
      white-space: nowrap;
    }
    .menu nav a:hover { border-bottom-color: var(--linea); }
    .menu nav a.activo { border-bottom-color: var(--u, var(--tinta)); color: inherit; }
  }

  /* --u para la raya de abajo (detalle, 3:1); --u-txt para la letra (4,5). */
  /* Con lugar, el botón de gift card muestra el texto además del moño. */
  @media (min-width: 1180px) {
    .regalo { padding: 0 1.1rem 0 0.9rem; }
    .regalo-texto { display: inline; }
  }

  .u-restaurante { --u: var(--u-restaurante); --u-txt: var(--u-restaurante-txt); }
  .u-hotel { --u: var(--u-hotel); --u-txt: var(--u-hotel-txt); }
  .u-balneario { --u: var(--u-balneario); --u-txt: var(--u-balneario-txt); }
  .u-eventos { --u: var(--u-eventos); --u-txt: var(--u-eventos-txt); }
</style>

<script>
  import { enCadaPagina } from "~/lib/enCadaPagina";

  /* En desktop el <details> tiene que estar siempre abierto; en angosto,
     cerrado al cargar y al navegar. Cada página trae su propia cabecera,
     cerrada, así que hay que volver a abrirla después de cada navegación:
     sin esto, en pantalla ancha (donde el botón del menú no se ve) los
     links desaparecían al primer clic. */
  const ancho = window.matchMedia("(min-width: 880px)");
  const quietud = window.matchMedia("(prefers-reduced-motion: reduce)");
  const menus = () => document.querySelectorAll<HTMLDetailsElement>(".cabecera .menu");
  const sincronizar = () =>
    menus().forEach((menu) => {
      menu.classList.remove("cerrando");
      menu.open = ancho.matches;
    });

  /* Cerrar con la animación de plegado: el <details> se cierra recién
     cuando termina, si no el panel desaparecería de golpe. */
  const cerrar = (menu: HTMLDetailsElement) => {
    if (!menu.open || menu.classList.contains("cerrando")) return;
    if (quietud.matches) { menu.open = false; return; }
    menu.classList.add("cerrando");
    const nav = menu.querySelector("nav");
    const listo = () => {
      menu.classList.remove("cerrando");
      menu.open = false;
    };
    nav?.addEventListener("animationend", listo, { once: true });
    /* Por si la animación no llega a correr (pestaña en segundo plano). */
    window.setTimeout(() => menu.classList.contains("cerrando") && listo(), 320);
  };

  enCadaPagina(sincronizar);

  /* Estos van una sola vez y buscan el menú en el momento: si se
     registraran en cada página se irían acumulando. */
  ancho.addEventListener("change", sincronizar);
  document.addEventListener("click", (e) => {
    if (ancho.matches) return;
    const destino = e.target as Element;
    menus().forEach((menu) => {
      /* El botón del menú: si está abierto, se cierra con animación en vez
         de dejar que el <details> se cierre en seco. */
      if (destino.closest("summary") && menu.contains(destino) && menu.open) {
        e.preventDefault();
        cerrar(menu);
        return;
      }
      if (menu.open && !menu.contains(destino)) cerrar(menu);
    });
  });
  /* Escape también cierra. */
  document.addEventListener("keydown", (e) => {
    if (e.key !== "Escape" || ancho.matches) return;
    menus().forEach((menu) => {
      if (!menu.open) return;
      cerrar(menu);
      menu.querySelector("summary")?.focus();
    });
  });
</script>
