---
import isologo from "~/assets/marca/isologo.svg?raw";
import { waLink } from "~/lib/contacto";

interface Props { unidadActiva?: string }
const { unidadActiva } = Astro.props;

const enlaces = [
  { id: "restaurante", texto: "Restaurante", href: "/restaurante" },
  { id: "hotel", texto: "Hotel", href: "/hotel" },
  { id: "balneario", texto: "Balneario", href: "/balneario" },
  { id: "eventos", texto: "Eventos", href: "/eventos" },
  { id: "galeria", texto: "Galería", href: "/galeria" },
  { id: "contacto", texto: "Contacto", href: "/contacto" },
];
const wa = await waLink("general");
---

<header class="cabecera">
  <a href="/" class="logo" aria-label="Mirador Waikiki, inicio">
    <span set:html={isologo} />
  </a>

  <a class="reservar" href={wa} target="_blank" rel="noopener">Reservar</a>

  <!-- En pantalla angosta el menú se pliega. Con <details> funciona sin
       JavaScript y el teclado lo abre y cierra como cualquier control. -->
  <details class="menu">
    <summary aria-label="Abrir el menú de secciones">
      <span class="barras" aria-hidden="true"><i></i><i></i><i></i></span>
      <span class="rotulo">Menú</span>
    </summary>
    <nav aria-label="Secciones del complejo">
      <ul>
        {
          enlaces.map((e) => (
            <li>
              <a
                href={e.href}
                class:list={[`u-${e.id}`, { activo: unidadActiva === e.id }]}
                aria-current={unidadActiva === e.id ? "page" : undefined}
              >
                {e.texto}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </details>
</header>

<style>
  .cabecera {
    display: grid;
    grid-template-columns: auto 1fr auto auto;
    align-items: center;
    gap: clamp(0.6rem, 2vw, 1.5rem);
    padding: 0.65rem var(--margen);
    background: var(--fondo);
    border-bottom: 1px solid var(--linea);
  }

  .logo {
    grid-area: 1 / 1;
    display: flex;
    color: var(--tinta);
  }
  .logo :global(svg) {
    height: clamp(34px, 3.4vw, 46px);
    width: auto;
  }

  .reservar {
    grid-area: 1 / 3;
    display: inline-flex;
    align-items: center;
    min-height: var(--toque);
    padding: 0 1.05rem;
    background: var(--accion-fondo);
    color: var(--accion-tinta);
    font-size: 0.9375rem;
    font-weight: 600;
    text-decoration: none;
    transition: background-color 0.2s;
  }
  .reservar:hover { background: #a96c22; }

  .menu { grid-area: 1 / 4; }

  summary {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: var(--toque);
    padding: 0 0.6rem;
    font-size: 0.875rem;
    font-weight: 600;
    list-style: none;
  }
  summary::-webkit-details-marker { display: none; }
  .barras { display: grid; gap: 4px; }
  .barras i { display: block; width: 20px; height: 2px; background: currentColor; }
  .menu[open] .barras i:nth-child(2) { opacity: 0; }
  .rotulo { display: none; }

  /* Panel plegado: ocupa el ancho completo debajo de la barra. */
  .menu nav {
    position: absolute;
    left: 0;
    right: 0;
    z-index: var(--z-flotante);
    background: var(--fondo);
    border-bottom: 1px solid var(--linea);
  }
  .menu ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    padding: 0.25rem var(--margen) 0.75rem;
  }
  .menu nav a {
    display: flex;
    align-items: center;
    min-height: 3.25rem;
    font-size: 1.0625rem;
    font-weight: 500;
    text-decoration: none;
    border-bottom: 1px solid var(--linea);
  }
  .menu nav li:last-child a { border-bottom: 0; }
  .menu nav a.activo { font-weight: 700; color: var(--u, var(--tinta)); }

  /* A partir de acá el menú es una barra horizontal y el botón desaparece. */
  @media (min-width: 880px) {
    .cabecera { grid-template-columns: auto 1fr auto; }
    .menu { grid-area: 1 / 2; }
    summary { display: none; }
    .reservar { grid-area: 1 / 3; }

    .menu nav {
      position: static;
      background: none;
      border: 0;
    }
    .menu ul {
      flex-direction: row;
      justify-content: flex-end;
      gap: clamp(0.9rem, 1.8vw, 1.7rem);
      padding: 0;
    }
    .menu nav a {
      min-height: var(--toque);
      font-size: 0.9375rem;
      border-bottom: 2px solid transparent;
      white-space: nowrap;
    }
    .menu nav a:hover { border-bottom-color: var(--linea); }
    .menu nav a.activo { border-bottom-color: var(--u, var(--tinta)); color: inherit; }
  }

  .u-restaurante { --u: var(--u-restaurante); }
  .u-hotel { --u: var(--u-hotel); }
  .u-balneario { --u: var(--u-balneario); }
  .u-eventos { --u: var(--u-eventos); }
</style>

<script>
  /* En desktop el <details> tiene que estar siempre abierto; en angosto,
     cerrado al cargar y al navegar. */
  const menu = document.querySelector<HTMLDetailsElement>(".cabecera .menu");
  if (menu) {
    const ancho = window.matchMedia("(min-width: 880px)");
    const sincronizar = () => { menu.open = ancho.matches; };
    sincronizar();
    ancho.addEventListener("change", sincronizar);
    document.addEventListener("click", (e) => {
      if (!ancho.matches && menu.open && !menu.contains(e.target as Node)) menu.open = false;
    });
  }
</script>
