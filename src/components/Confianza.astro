---
/**
 * Prueba social, según el patrón «Hero-Centric + Social Proof» que el plugin
 * recomienda para hotelería.
 *
 * Dos capas, y ninguna inventada:
 *  · Datos verificables del complejo (años, seguidores reales de las cuentas).
 *  · Testimonios, sólo si hay reseñas reales cargadas. Si la colección está
 *    vacía, ese bloque no existe.
 */
import { datosSitio } from "~/lib/contacto";
import FondoFoto from "./FondoFoto.astro";

const sitio = await datosSitio();
const testimonios = sitio.testimonios;

const anios = new Date().getFullYear() - sitio.desde;

const datos = [
  { cifra: String(anios), rotulo: "años en el mismo lugar", nota: `Desde ${sitio.desde}` },
  { cifra: "4", rotulo: "unidades en un predio", nota: "Restaurante, hotel, balneario y eventos" },
  { cifra: "1ª", rotulo: "línea de playa", nota: "Bajada directa a la arena" },
];
---

<section class="confianza banda-turquesa con-fondo" data-revelar>
  <FondoFoto foto={sitio.fotos.confianza} sombra="pareja" />
  <div class="interior sobre-foto">
    <ul class="cifras" data-revelar-grupo="3">
      {
        datos.map((d) => (
          <li>
            <span class="cifra">{d.cifra}</span>
            <span class="rotulo-cifra">{d.rotulo}</span>
            <span class="nota">{d.nota}</span>
          </li>
        ))
      }
    </ul>

    {
      testimonios.length > 0 && (
        <>
          <div class="encabezado centrado">
            <p class="rotulo">Lo que dicen</p>
            <h2>Quienes ya vinieron</h2>
          </div>
          <ul class="citas">
            {testimonios.slice(0, 5).map((t) => (
              <li class="caja">
                <blockquote>{t.texto}</blockquote>
                <p class="firma-cita">
                  <span class="nombre">{t.nombre}</span>
                  <span class="origen">{t.origen}</span>
                </p>
              </li>
            ))}
          </ul>
        </>
      )
    }
  </div>
</section>

<style>
  .confianza {
    border-block: 1px solid var(--linea);
    padding: var(--paso) var(--margen) var(--paso-abajo);
  }
  .interior { max-width: var(--ancho); margin-inline: auto; }

  /* Tres cajas iguales en fila es el patrón de plantilla por excelencia.
     Acá van como una línea editorial: la cifra enorme en la serif, el dato
     chico debajo, y un filete vertical que las separa en vez de tres
     rectángulos con sombra.

     Las cifras usan cifras tabulares para que el 27 y el 4 apoyen sobre la
     misma línea óptica. */
  .cifras {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0;
    list-style: none;
  }
  .cifras li {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding: 1.6rem 0;
    border-top: 1px solid var(--linea);
  }
  .cifras li:last-child { border-bottom: 1px solid var(--linea); }

  @media (min-width: 720px) {
    .cifras {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      column-gap: clamp(2rem, 5vw, 4.5rem);
      border-top: 1px solid var(--linea);
      border-bottom: 1px solid var(--linea);
    }
    .cifras li {
      padding: clamp(2rem, 3.5vw, 3rem) 0;
      border-top: 0;
    }
    .cifras li:last-child { border-bottom: 0; }
    /* El filete separa, no encierra: sólo entre columnas. */
    .cifras li + li {
      padding-left: clamp(2rem, 5vw, 4.5rem);
      border-left: 1px solid var(--linea);
      margin-left: calc(clamp(2rem, 5vw, 4.5rem) * -1);
    }
  }

  .cifra {
    font-family: var(--f-display);
    font-size: clamp(3.25rem, 6vw, 5.25rem);
    font-weight: 400;
    line-height: 0.92;
    letter-spacing: var(--track-display);
    font-variant-numeric: tabular-nums lining-nums;
    color: var(--acento);
  }
  .rotulo-cifra {
    font-family: var(--f-ui);
    font-size: var(--t-eyebrow);
    font-weight: 600;
    letter-spacing: var(--track-eyebrow);
    text-transform: uppercase;
    margin-top: 0.7rem;
  }
  .nota { font-size: 0.9rem; color: var(--sobre-oscuro); }

  .citas {
    display: grid;
    gap: clamp(0.85rem, 1.8vw, 1.5rem);
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    list-style: none;
  }
  .citas li {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    padding: 2rem 1.75rem;
  }
  blockquote {
    margin: 0;
    font-family: var(--f-firma);
    font-style: italic;
    font-size: 1.0625rem;
    line-height: 1.5;
  }
  .firma-cita { display: flex; flex-direction: column; gap: 0.2rem; margin-top: auto; }
  .nombre { font-size: 0.9rem; font-weight: 500; }
  .origen {
    font-size: var(--t-eyebrow);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--tinta-suave);
  }
</style>
