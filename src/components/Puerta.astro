---
/**
 * Una de las cuatro puertas del home.
 *
 * No son cuatro columnas iguales: eso se lee como catálogo y aplana la
 * jerarquía. El restaurante va grande y vertical —es lo que más gente busca,
 * y lo único que abre todos los días— y las otras tres van compactas y
 * horizontales al costado.
 *
 * La pieza va montada en bandeja: marco exterior, núcleo adentro, radios
 * concéntricos.
 */
import Foto from "./Foto.astro";
import Estado from "./Estado.astro";
import type { Estado as EstadoTipo } from "~/lib/estado";

interface Props {
  id: "restaurante" | "hotel" | "balneario" | "eventos";
  nombre: string;
  bajada: string;
  href: string;
  estado: EstadoTipo;
  cta: string;
  ctaHref: string;
  foto: { src: ImageMetadata; alt: string; foco?: "centro" | "arriba" | "abajo" } | null;
  ornamento: "caracol" | "vieira" | "ammonite" | "coral";
  destacada?: boolean;
}
const { id, nombre, bajada, href, estado, cta, ctaHref, foto, ornamento, destacada = false } =
  Astro.props;
const fuera = ctaHref.startsWith("http");
---

<article class:list={["puerta", "bandeja", `u-${id}`, { destacada }]}>
  <div class="bandeja-nucleo">
    <div class="visual">
      <Foto
        foto={foto}
        unidad={id}
        ornamento={ornamento}
        pendiente={`Foto de ${nombre.toLowerCase()} pendiente`}
        anchos={destacada ? [520, 760, 1100] : [280, 420, 600]}
        sizes={destacada
          ? "(max-width: 899px) 100vw, 46vw"
          : "(max-width: 899px) 100vw, 18vw"}
      />
    </div>

    <div class="cuerpo">
      <h3 class="nombre"><a href={href}>{nombre}</a></h3>
      <p class="bajada">{bajada}</p>
      <Estado estado={estado} unidad={id} class="est" />
      <a
        class="cta"
        href={ctaHref}
        {...fuera ? { target: "_blank", rel: "noopener" } : {}}
      >
        <span>{cta}</span>
        <span class="disco" aria-hidden="true">
          <svg viewBox="0 0 16 12" width="12" height="9" focusable="false">
            <path d="M0 6h12M8 1l5 5-5 5" fill="none" stroke="currentColor"
              stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </span>
      </a>
    </div>
  </div>
</article>

<style>
  .puerta { position: relative; }

  /* Filete del color de la unidad, dentro del núcleo. */
  .bandeja-nucleo::before {
    content: "";
    position: absolute;
    inset: 0 0 auto;
    height: 3px;
    background: var(--u);
    z-index: 2;
    transition: height var(--transicion);
  }
  .puerta:hover .bandeja-nucleo::before { height: 5px; }

  .visual { overflow: hidden; flex: none; }
  .visual :global(img) { width: 100%; height: 100%; object-fit: cover; }

  .cuerpo {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    flex: 1;
    min-width: 0;
    padding: 1.15rem 1.25rem 1.3rem;
  }

  .nombre {
    font-family: var(--f-ui);
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: var(--track-eyebrow);
    text-transform: uppercase;
    color: var(--u-txt);
  }
  .nombre a { text-decoration: none; }
  /* Toda la pieza es clickeable, pero el foco de teclado va al título. */
  .nombre a::after { content: ""; position: absolute; inset: 0; }

  .bajada {
    font-family: var(--f-display);
    font-size: 1.0625rem;
    line-height: 1.3;
    letter-spacing: -0.01em;
    text-wrap: pretty;
  }

  .cta {
    position: relative;
    z-index: var(--z-base);
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.6em;
    min-height: var(--toque);
    margin-top: auto;
    padding: 0.4em 0.4em 0.4em 1.1em;
    background: transparent;
    color: var(--acento);
    border: 1px solid var(--acento-tenue);
    border-radius: 999px;
    font-family: var(--f-ui);
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    line-height: 1.3;
    text-decoration: none;
    transition:
      background-color var(--transicion),
      color var(--transicion),
      border-color var(--transicion),
      transform 160ms var(--curva);
  }
  .cta .disco {
    display: grid;
    place-items: center;
    width: 1.75rem;
    height: 1.75rem;
    flex: none;
    border-radius: 999px;
    background: rgb(128 128 128 / 0.14);
    background: color-mix(in srgb, currentColor 11%, transparent);
    transition: transform var(--transicion), background-color var(--transicion);
  }
  .cta:hover {
    background: var(--accion-hover-fondo);
    color: var(--accion-hover-tinta);
    border-color: var(--accion-hover-fondo);
  }
  .cta:hover .disco {
    transform: translate(3px, -1px) scale(1.06);
    background: rgb(128 128 128 / 0.22);
    background: color-mix(in srgb, currentColor 18%, transparent);
  }
  .cta:active { transform: scale(0.98); }

  /* ── Apilada: una columna, foto arriba. Es la forma en móvil y la de la
        pieza destacada en escritorio. ──────────────────────────────────── */
  .visual { aspect-ratio: 16 / 10; }

  /* ── Compacta en escritorio: foto a la izquierda, texto al lado ──────── */
  @media (min-width: 900px) {
    .puerta:not(.destacada) .bandeja-nucleo { flex-direction: row; }
    .puerta:not(.destacada) .visual {
      aspect-ratio: auto;
      width: 38%;
      max-width: 13rem;
    }
    .puerta:not(.destacada) .cuerpo { padding: 1rem 1.15rem 1.05rem; gap: 0.5rem; }
    .puerta:not(.destacada) .bajada { font-size: 1rem; }

    .destacada .visual { aspect-ratio: 4 / 3; }
    .destacada .cuerpo { padding: 1.6rem 1.75rem 1.75rem; gap: 0.8rem; }
    .destacada .bajada { font-size: clamp(1.25rem, 1.6vw, 1.6rem); }
    .destacada .cta { align-self: flex-start; }
  }

  .u-restaurante { --u: var(--u-restaurante); --u-txt: var(--u-restaurante-txt); }
  .u-hotel { --u: var(--u-hotel); --u-txt: var(--u-hotel-txt); }
  .u-balneario { --u: var(--u-balneario); --u-txt: var(--u-balneario-txt); }
  .u-eventos { --u: var(--u-eventos); --u-txt: var(--u-eventos-txt); }

  @media (prefers-reduced-motion: reduce) {
    .cta, .cta .disco, .bandeja-nucleo::before { transition: none; }
    .cta:hover .disco, .cta:active { transform: none; }
  }
</style>
