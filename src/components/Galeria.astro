---
/**
 * Grilla asimétrica: la primera foto ocupa dos columnas para que no sea otra
 * grilla de cards iguales. Sin librería de lightbox: <dialog> nativo.
 */
import { getImage } from "astro:assets";
import Foto from "./Foto.astro";

interface Props {
  fotos: { src: ImageMetadata; alt: string; foco?: "centro" | "arriba" | "abajo" }[];
  unidad?: "restaurante" | "hotel" | "balneario" | "eventos" | "complejo";
  titulo?: string;
}
const { fotos, unidad = "complejo", titulo } = Astro.props;

/* Versión grande de cada foto para el visor. Antes el visor abría la misma
   versión de la miniatura (400 a 700 px) y la estiraba a pantalla completa:
   se veía borrosa. El navegador elige de estas la justa para su pantalla. */
const grandes = await Promise.all(
  fotos.map(async (f) => {
    const anchos = [800, 1200, 1800].filter((w) => w <= f.src.width);
    if (anchos.length === 0) anchos.push(f.src.width);
    const hechas = await Promise.all(
      anchos.map((width) => getImage({ src: f.src, width, format: "webp" })),
    );
    return {
      srcset: hechas.map((h) => `${h.src} ${h.attributes.width}w`).join(", "),
      src: hechas[hechas.length - 1].src,
    };
  }),
);
---

{
  fotos.length > 0 && (
    <div class="galeria">
      {titulo && <h2>{titulo}</h2>}
      <ul data-revelar-grupo="6">
        {fotos.map((f, i) => (
          <li class:list={{ ancha: i === 0, "ancha-movil": i === 0 && fotos.length % 2 === 1 }}>
            <button
              type="button"
              data-abrir={i}
              data-grande={grandes[i].src}
              data-grande-srcset={grandes[i].srcset}
              data-ancho={f.src.width}
              data-alto={f.src.height}
              aria-label={`Ampliar: ${f.alt}`}
            >
              <Foto
                foto={f}
                unidad={unidad}
                anchos={[400, 700, 1100]}
                sizes="(max-width: 640px) 50vw, 33vw"
              />
            </button>
          </li>
        ))}
      </ul>

      <dialog class="visor">
        <button class="cerrar" type="button" aria-label="Cerrar la foto ampliada">✕</button>
        <img alt="" />
        <p class="pie-visor" />
      </dialog>
    </div>
  )
}

<style>
  .galeria h2 { margin-bottom: 1.5rem; }

  ul {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(0.6rem, 1.2vw, 1rem);
    list-style: none;
  }
  @media (min-width: 720px) {
    ul { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .ancha { grid-column: span 2; grid-row: span 2; }
  }

  /* En el celular (dos columnas) la primera ocupa el ancho sólo si la
     cantidad es impar: así la última fila nunca queda con una foto sola. */
  @media (max-width: 719px) {
    .ancha-movil { grid-column: span 2; }
  }
  li { aspect-ratio: 1; }
  .ancha { aspect-ratio: 1; }

  button[data-abrir] {
    min-height: var(--toque);
    display: block;
    width: 100%;
    height: 100%;
    padding: 0;
    border: 0;
    background: none;
    cursor: zoom-in;
  }

  /* El visor se ajusta a la foto y la foto entra entera en la pantalla,
     vertical u horizontal: se achica si hace falta, nunca se recorta. Antes
     tenía ancho fijo y la foto crecía a lo alto: una vertical quedaba
     cortada y se veía sólo un pedazo. */
  .visor {
    width: fit-content;
    max-width: min(94vw, 1100px);
    max-height: 94vh;
    max-height: 94dvh;
    padding: 0;
    border: 0;
    border-radius: var(--radio);
    overflow: hidden;
    background: rgb(var(--velo));
    color: var(--sobre-oscuro);
  }
  .visor[open] { display: flex; flex-direction: column; }
  .visor::backdrop { background: rgb(var(--velo) / 0.9); }
  .visor img {
    display: block;
    /* Centrada y no estirada al ancho del visor: estirada, una foto vertical
       quedaba con franjas a los costados. */
    align-self: center;
    width: auto;
    height: auto;
    max-width: min(94vw, 1100px);
    /* Lo que queda después del pie de foto (hasta tres renglones). */
    max-height: calc(94vh - 5.5rem);
    max-height: calc(94dvh - 5.5rem);
    object-fit: contain;
  }
  /* El pie no ensancha el visor: mide lo que mide la foto. Hasta tres
     renglones; lo que sobra se corta con «…». */
  .pie-visor {
    width: 0;
    min-width: 100%;
    padding: 0.8rem 1.1rem 0.9rem;
    font-size: 0.875rem;
    line-height: 1.4;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
    line-clamp: 3;
    overflow: hidden;
  }
  .cerrar {
    position: absolute;
    top: 0.5rem;
    right: 0.5rem;
    width: 2.5rem;
    height: 2.5rem;
    border: 0;
    background: var(--acento);
    color: var(--sobre-acento);
    font-size: 1rem;
    cursor: pointer;
  }
</style>

<script>
  import { enCadaPagina } from "~/lib/enCadaPagina";

  enCadaPagina(() => {
    const visores: HTMLDialogElement[] = [];

    document.querySelectorAll<HTMLElement>(".galeria").forEach((galeria) => {
      const visor = galeria.querySelector<HTMLDialogElement>(".visor");
      const img = visor?.querySelector("img");
      const pie = visor?.querySelector<HTMLElement>(".pie-visor");
      if (!visor || !img || !pie) return;
      visores.push(visor);

      galeria.querySelectorAll<HTMLButtonElement>("[data-abrir]").forEach((boton) => {
        boton.addEventListener("click", () => {
          const original = boton.querySelector("img");
          if (!original) return;
          /* La versión grande. El ancho y alto reales le dan la proporción
             antes de que cargue, así el visor no salta. */
          img.width = Number(boton.dataset.ancho) || original.naturalWidth;
          img.height = Number(boton.dataset.alto) || original.naturalHeight;
          img.sizes = "min(94vw, 1100px)";
          img.srcset = boton.dataset.grandeSrcset ?? "";
          img.src = boton.dataset.grande ?? (original.currentSrc || original.src);
          img.alt = original.alt;
          pie.textContent = original.alt;
          visor.showModal();
        });
      });

      visor.querySelector(".cerrar")?.addEventListener("click", () => visor.close());
      visor.addEventListener("click", (e) => { if (e.target === visor) visor.close(); });
    });

    /* Con el visor abierto se puede salir con el botón atrás del navegador.
       Se cierra antes del cambio para que la transición no arranque con la
       foto ampliada encima. */
    return () => visores.forEach((v) => v.open && v.close());
  });
</script>
