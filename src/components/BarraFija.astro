---
/**
 * En móvil, reservar tiene que estar siempre a mano sin tapar contenido.
 * Aparece pasado el hero y se esconde al llegar al pie; el <main> reserva
 * el espacio, así que nunca se come el último párrafo.
 */
interface Props { texto: string; href: string }
const { texto, href } = Astro.props;
---

<a class="barra" href={href} {...href.startsWith("http") ? { target: "_blank", rel: "noopener" } : {}}>
  {texto}
</a>

<style>
  .barra {
    position: fixed;
    inset: auto 0 0 0;
    z-index: var(--z-fijo);
    display: none;
    padding: 1rem;
    background: var(--acento);
    color: var(--sobre-acento);
    font-size: 0.76rem;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    text-align: center;
    text-decoration: none;
    transform: translateY(100%);
    transition: transform 0.25s ease-out;
  }
  .barra.visible { transform: translateY(0); }

  @media (max-width: 860px) {
    .barra { display: block; }
    :global(body) { padding-bottom: 3.5rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    .barra { transition: none; }
  }
</style>

<script>
  import { enCadaPagina } from "~/lib/enCadaPagina";

  enCadaPagina(() => {
    const barra = document.querySelector<HTMLElement>(".barra");
    const hero = document.querySelector<HTMLElement>("[data-hero]");
    const pie = document.querySelector<HTMLElement>("footer");
    if (!barra || !hero) return;

    let pasoElHero = false;
    let llegoAlPie = false;
    const refrescar = () => barra.classList.toggle("visible", pasoElHero && !llegoAlPie);

    const ojos = [
      new IntersectionObserver(
        ([e]) => { pasoElHero = !e.isIntersecting; refrescar(); },
        { rootMargin: "-60px 0px 0px 0px" },
      ),
    ];
    ojos[0].observe(hero);

    if (pie) {
      const ojoPie = new IntersectionObserver(
        ([e]) => { llegoAlPie = e.isIntersecting; refrescar(); },
      );
      ojoPie.observe(pie);
      ojos.push(ojoPie);
    }

    return () => ojos.forEach((o) => o.disconnect());
  });
</script>
