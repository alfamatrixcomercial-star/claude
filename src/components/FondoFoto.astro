---
/**
 * Foto a sangre detrás de un bloque de texto. Sin ninguna capa encima: la
 * foto se ve entera y con sus colores. El texto del bloque va sobre una
 * .placa (base.css), que es lo que lo hace legible.
 *
 * El bloque que la contiene lleva la clase `con-fondo` (lo posiciona y lo
 * aísla) y `sobre-foto` en lo que va encima (tinta clara).
 */
import Foto from "./Foto.astro";

interface Props {
  foto: { src: ImageMetadata; alt: string; foco?: "centro" | "arriba" | "abajo" };
  /** Sólo para el primer bloque de la página, que se ve sin scrollear. */
  prioridad?: boolean;
}
const { foto, prioridad = false } = Astro.props;
---

<div class="fondo-foto">
  <Foto foto={foto} prioridad={prioridad} sizes="100vw" anchos={[640, 1024, 1600, 2200]} />
</div>

<style>
  .fondo-foto {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--fondo-alt);
  }
  .fondo-foto :global(img) {
    position: absolute;
    inset: 0;
  }
</style>
