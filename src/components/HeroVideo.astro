---
/**
 * Primera impresión del sitio: video.
 *
 * Reglas que se respetan, del brief y del plugin:
 *  · Mudo y en bucle, sin controles: es ambiente, no un reproductor.
 *  · `poster` para la primera pintura, así nunca hay un rectángulo negro.
 *  · No arranca si el visitante pide menos movimiento o tiene ahorro de
 *    datos: en ese caso queda el poster, que es una foto del lugar.
 *  · En pantallas chicas tampoco arranca solo: 770 KB no se le imponen a
 *    una conexión móvil de enero.
 */
import { getImage } from "astro:assets";

interface Props {
  /** Sin extensión: se sirven .webm y .mp4 desde la misma base. */
  src: string;
  poster: ImageMetadata;
  /** Foto para pantallas angostas, donde el video no arranca y la
   *  horizontal recortada a lo alto pierde casi todo el cuadro. */
  posterVertical?: ImageMetadata;
  alt: string;
}
const { src, poster, posterVertical, alt } = Astro.props;

/* Se arma el <picture> a mano porque el componente de Astro no cambia de
   foto según el ancho de pantalla: sólo cambia de tamaño. */
async function juego(foto: ImageMetadata, anchos: number[], format: "avif" | "webp" | "jpeg") {
  const hechas = await Promise.all(
    anchos.filter((w) => w <= foto.width).map((width) => getImage({ src: foto, width, format })),
  );
  return hechas.map((h) => `${h.src} ${h.attributes.width}w`).join(", ");
}
const ANCHOS = [720, 1200, 1800];
const ANCHOS_VERTICAL = [480, 720, 1080, 1440];
const horizontal = {
  avif: await juego(poster, ANCHOS, "avif"),
  webp: await juego(poster, ANCHOS, "webp"),
  jpeg: await juego(poster, ANCHOS, "jpeg"),
};
const vertical = posterVertical && {
  avif: await juego(posterVertical, ANCHOS_VERTICAL, "avif"),
  webp: await juego(posterVertical, ANCHOS_VERTICAL, "webp"),
};
const base = await getImage({ src: poster, width: 1200, format: "jpeg" });
const ANGOSTO = "(max-width: 700px)";
---

<div class="fondo-video" data-video={src}>
  <picture>
    {vertical && <source media={ANGOSTO} type="image/avif" srcset={vertical.avif} sizes="100vw" />}
    {vertical && <source media={ANGOSTO} type="image/webp" srcset={vertical.webp} sizes="100vw" />}
    <source type="image/avif" srcset={horizontal.avif} sizes="100vw" />
    <source type="image/webp" srcset={horizontal.webp} sizes="100vw" />
    <img
      src={base.src}
      srcset={horizontal.jpeg}
      sizes="100vw"
      width={base.attributes.width}
      height={base.attributes.height}
      alt={alt}
      loading="eager"
      fetchpriority="high"
      decoding="async"
      class="poster"
    />
  </picture>
  <video muted loop playsinline preload="none" aria-hidden="true"></video>
</div>

<style>
  .fondo-video { position: absolute; inset: 0; z-index: -2; background: var(--fondo-alt); }

  .poster,
  video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  /* En angosto se ve la foto vertical: corrida a la derecha entran el
     restaurante y la pileta, que centrada quedaban cortados. */
  @media (max-width: 700px) {
    .poster { object-position: 64% center; }
  }
  video { opacity: 0; transition: opacity 700ms ease; }
  video.visible { opacity: 1; }

  /* Sin velo propio: la sombra que hace legible el texto la pone el hero,
     una sola y sólo donde cae el texto. Con velo acá y otro en el hero se
     apilaban cuatro degradados y el video llegaba a pantalla casi negro. */

  @media (prefers-reduced-motion: reduce) {
    video { display: none; }
  }
</style>

<script>
  import { enCadaPagina } from "~/lib/enCadaPagina";

  enCadaPagina(() => {
    const bloque = document.querySelector<HTMLElement>(".fondo-video");
    const video = bloque?.querySelector("video");
    const src = bloque?.dataset.video;
    if (!bloque || !video || !src) return;

    const quietud = window.matchMedia("(prefers-reduced-motion: reduce)");
    const angosto = window.matchMedia("(max-width: 700px)");
    const ahorro = (navigator as any).connection?.saveData === true;
    if (quietud.matches || angosto.matches || ahorro) return;

    /* Se carga recién cuando el navegador terminó con lo importante. */
    const arrancar = () => {
      /* El mp4 va primero: en este material pesa menos que el webm y lo
         lee todo el mundo. El webm queda de reserva para los navegadores
         compilados sin H.264. */
      for (const [tipo, ext] of [
        ["video/mp4", "mp4"],
        ["video/webm", "webm"],
      ]) {
        const fuente = document.createElement("source");
        fuente.src = `${src}.${ext}`;
        fuente.type = tipo;
        video.appendChild(fuente);
      }
      video.load();
      video.play().then(() => video.classList.add("visible")).catch(() => {});
    };
    if (document.readyState === "complete") arrancar();
    else window.addEventListener("load", arrancar, { once: true });

    /* Al irse de la página el video sale del documento pero sigue bajando
       hasta que el navegador lo descarta. Sin fuentes y con load() corta
       la descarga en el momento. */
    return () => {
      window.removeEventListener("load", arrancar);
      video.pause();
      video.querySelectorAll("source").forEach((f) => f.remove());
      video.load();
    };
  });
</script>
