---
/**
 * Piezas del Kit Mar del manual, en marca de agua. Decoran, no informan:
 * siempre aria-hidden y siempre por debajo del texto.
 */
import caracol from "~/assets/marca/mar-caracol.svg?raw";
import vieira from "~/assets/marca/mar-vieira.svg?raw";
import ammonite from "~/assets/marca/mar-ammonite.svg?raw";
import coral from "~/assets/marca/mar-coral.svg?raw";

const piezas = { caracol, vieira, ammonite, coral };

interface Props {
  pieza: keyof typeof piezas;
  class?: string;
}
const { pieza, class: clase } = Astro.props;
---

<div class:list={["ornamento", clase]} aria-hidden="true" set:html={piezas[pieza]} />

<style>
  .ornamento {
    color: currentColor;
    opacity: 0.09;
    pointer-events: none;
  }
  .ornamento :global(svg) { width: 100%; height: auto; }
</style>
