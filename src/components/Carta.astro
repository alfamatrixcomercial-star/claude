---
/**
 * La carta en HTML, en acordeón por sección. Nada de PDF como pieza
 * principal: en el celular un PDF pesa, no se indexa y obliga a pellizcar.
 * Sin precios, por decisión del cliente: el esquema no los admite.
 */
interface Props {
  carta: { seccion: string; items: { nombre: string; descripcion?: string }[] }[];
}
const { carta } = Astro.props;
---

<div class="carta">
  {
    carta.map((s, i) => (
      <details open={i === 0} name="carta">
        <summary>
          <span>{s.seccion}</span>
          <svg viewBox="0 0 14 14" width="13" height="13" aria-hidden="true" focusable="false">
            <path d="M7 1v12M1 7h12" fill="none" stroke="currentColor" stroke-width="1.8" />
          </svg>
        </summary>
        <ul>
          {s.items.map((p) => (
            <li>
              <b>{p.nombre}</b>
              {p.descripcion && <span>{p.descripcion}</span>}
            </li>
          ))}
        </ul>
      </details>
    ))
  }
</div>

<style>
  .carta { border-top: 2px solid var(--linea-fuerte); }

  details { border-bottom: 1px solid var(--linea); }

  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.1rem 0;
    cursor: pointer;
    font-family: var(--f-display);
    font-size: var(--t-h3);
    font-weight: 700;
    letter-spacing: -0.02em;
    list-style: none;
  }
  summary::-webkit-details-marker { display: none; }
  summary svg { flex: none; transition: transform 0.2s; }
  details[open] summary svg { transform: rotate(45deg); }

  ul { list-style: none; padding-bottom: 1.25rem; display: grid; gap: 1rem; }
  @media (min-width: 720px) {
    ul { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem 3rem; }
  }

  li b { display: block; font-weight: 600; }
  li span {
    display: block;
    color: var(--tinta-suave);
    font-size: 0.95rem;
    line-height: 1.5;
    max-width: 46ch;
  }
</style>
