---
/**
 * «También en el complejo». El complejo es uno solo y esa es su ventaja:
 * quien se casa acá aloja invitados en el hotel, quien veranea cena en el
 * restaurante. Este bloque cierra cada página de unidad.
 */
import { getCollection } from "astro:content";
import Estado from "./Estado.astro";
import Foto from "./Foto.astro";
import { estadoDeUnidad } from "~/lib/estado";

interface Props { excepto: string }
const { excepto } = Astro.props;

const otras = (await getCollection("unidades"))
  .filter((u) => u.id !== excepto)
  .sort((a, b) => a.data.orden - b.data.orden);
---

<section class="cruce">
  <div class="interior">
    <h2>También en el complejo</h2>
    <ul data-revelar-grupo="3">
      {
        otras.map((u) => (
          <li class:list={["caja", `u-${u.id}`]}>
            <div class="media">
              <Foto
                foto={u.data.hero}
                unidad={u.id as any}
                ornamento={u.data.ornamento}
                sizes="(min-width: 900px) 30vw, 100vw"
                anchos={[480, 800]}
              />
            </div>
            <a href={`/${u.id}`}>
              <span class="nombre">{u.data.nombre}</span>
              <span class="bajada">{u.data.bajada}</span>
            </a>
            <Estado
              estado={estadoDeUnidad({
                horarios: u.data.horarios,
                temporada: u.data.temporada,
                estadoFijo: u.data.estadoFijo,
              })}
              unidad={u.id as any}
            />
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .cruce {
    background: var(--fondo-alt);
    border-top: 1px solid var(--linea);
    padding: var(--paso) var(--margen);
  }
  .interior { max-width: var(--ancho); margin-inline: auto; }

  h2 {
    font-family: var(--f-texto);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--tinta-suave);
    margin-bottom: 1.75rem;
  }

  ul {
    display: grid;
    gap: clamp(0.85rem, 1.6vw, 1.25rem);
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    list-style: none;
  }
  li {
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
    padding: 0 0 1.7rem;
    overflow: hidden;
  }
  /* La foto de la unidad arriba, a sangre dentro de la tarjeta. */
  .media {
    aspect-ratio: 16 / 10;
    margin-bottom: 0.6rem;
    overflow: hidden;
  }
  .media :global(img) { transition: transform 900ms var(--curva); }
  @media (hover: hover) {
    li:hover .media :global(img) { transform: scale(1.04); }
  }
  @media (prefers-reduced-motion: reduce) {
    .media :global(img) { transition: none; }
    li:hover .media :global(img) { transform: none; }
  }
  li > a, li > :global(.estado) { margin-inline: 1.6rem; }

  a { text-decoration: none; display: block; padding-block: 0.35rem; }
  .nombre {
    display: block;
    font-family: var(--f-display);
    font-size: var(--t-h3);
    font-weight: 700;
    letter-spacing: -0.02em;
  }
  a:hover .nombre { text-decoration: underline; text-decoration-thickness: 2px; }
  .bajada {
    display: block;
    margin-top: 0.3rem;
    font-size: 0.925rem;
    color: var(--tinta-suave);
  }

  .u-restaurante { --u: var(--u-restaurante-txt); }
  .u-hotel { --u: var(--u-hotel-txt); }
  .u-balneario { --u: var(--u-balneario-txt); }
  .u-eventos { --u: var(--u-eventos-txt); }

  /* La tarjeta entera lleva a la unidad. Antes sólo respondía el título:
     una caja que se levanta al pasar el mouse y no se deja tocar en el
     medio es una promesa rota. El foco de teclado sigue yendo al enlace. */
  li { position: relative; }
  li > a::after { content: ""; position: absolute; inset: 0; }
  /* El estado queda por encima para que se pueda seleccionar su texto. */
  li :global(.estado) { position: relative; z-index: var(--z-base); }
</style>
