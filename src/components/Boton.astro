---
/**
 * El botón dice exactamente qué pasa al tocarlo. «Reservar mesa», no
 * «Contactanos». El primario es ámbar con tinta verde profundo: blanco
 * sobre ámbar da 3.26 y no se usa nunca.
 */
interface Props {
  href: string;
  jerarquia?: "primaria" | "secundaria";
  externo?: boolean;
  class?: string;
}
const { href, jerarquia = "primaria", externo = false, class: clase } = Astro.props;
const fuera = externo || href.startsWith("http");
---

<a
  href={href}
  class:list={["boton", jerarquia, clase]}
  {...fuera ? { target: "_blank", rel: "noopener" } : {}}
>
  <span><slot /></span>
  <svg viewBox="0 0 16 12" width="15" height="11" aria-hidden="true" focusable="false">
    <path d="M0 6h13M9 1l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.8" />
  </svg>
</a>

<style>
  .boton {
    display: inline-flex;
    align-items: center;
    gap: 0.9em;
    min-height: var(--toque);
    padding: 0.7em 1.5em;
    font-family: var(--f-texto);
    font-size: 0.78rem;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    text-decoration: none;
    background: var(--accion-fondo);
    color: var(--accion-tinta);
    border: 1px solid var(--accion-borde);
    transition: background-color 0.25s, color 0.25s, border-color 0.25s;
  }
  .boton svg { flex: none; transition: transform 0.25s; }
  .boton:hover {
    background: var(--accion-hover-fondo);
    color: var(--accion-hover-tinta);
    border-color: var(--accion-hover-fondo);
  }
  .boton:hover svg { transform: translateX(3px); }

  /* La secundaria es aún más tenue: el filete apenas se insinúa. */
  .secundaria {
    color: var(--tinta-suave);
    border-color: var(--linea);
  }
  .secundaria:hover {
    background: transparent;
    color: var(--tinta);
    border-color: var(--tinta-suave);
  }

  @media (prefers-reduced-motion: reduce) {
    .boton:hover svg { transform: none; }
  }
</style>
