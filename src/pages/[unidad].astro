---
import type { GetStaticPaths } from "astro";
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import type { CollectionEntry } from "astro:content";
import Base from "~/layouts/Base.astro";
import Onda from "~/components/Onda.astro";
import Foto from "~/components/Foto.astro";
import Boton from "~/components/Boton.astro";
import Estado from "~/components/Estado.astro";
import Ficha from "~/components/Ficha.astro";
import Galeria from "~/components/Galeria.astro";
import Video from "~/components/Video.astro";
import HeroRetrato from "~/components/HeroRetrato.astro";
import Cruce from "~/components/Cruce.astro";
import MarcoFoto from "~/components/MarcoFoto.astro";
import BarraFija from "~/components/BarraFija.astro";
import Ornamento from "~/components/Ornamento.astro";
import { estadoDeUnidad } from "~/lib/estado";
import { datosSitio, waLink, wokiLink } from "~/lib/contacto";

export const getStaticPaths: GetStaticPaths = async () => {
  const unidades = await getCollection("unidades");
  return unidades.map((u) => ({ params: { unidad: u.id }, props: { u } }));
};

type Props = { u: CollectionEntry<"unidades"> };
const { u } = Astro.props as Props;
const d = u.data;
const id = u.id as "restaurante" | "hotel" | "balneario" | "eventos";

const sitio = await datosSitio();
const woki = await wokiLink();

/** Resuelve cada CTA a su destino real. Ningún wa.me escrito a mano. */
const ctas = (
  await Promise.all(
    d.ctas.map(async (c) => {
      if (c.tipo === "woki") return woki ? { texto: c.texto, href: woki } : null;
      if (c.tipo === "externo") return c.href ? { texto: c.texto, href: c.href } : null;
      if (c.tipo === "whatsapp") return { texto: c.texto, href: await waLink(id) };
      return { texto: c.texto, href: c.href ?? "/contacto" };
    }),
  )
).filter((c): c is { texto: string; href: string } => c !== null);

/* Cada unidad tiñe sus bandas hacia su propio color. Así el sitio deja de
   ser un verde único de punta a punta y cada sección cambia de temperatura
   sin salirse de la paleta. */
const banda = {
  restaurante: "banda-verde",
  hotel: "banda-salvia",
  balneario: "banda-turquesa",
  eventos: "banda-arena",
}[id];

const estado = estadoDeUnidad({
  horarios: d.horarios,
  temporada: d.temporada,
  estadoFijo: d.estadoFijo,
});

const url = new URL(`/${u.id}`, Astro.site).href;
const datosEstructurados = {
  "@context": "https://schema.org",
  "@type": d.schema === "BeachResort" ? "LocalBusiness" : d.schema,
  name: d.nombreLargo,
  description: d.seo.descripcion,
  url,
  address: {
    "@type": "PostalAddress",
    streetAddress: sitio.direccion.calle,
    addressLocality: sitio.direccion.localidad,
    addressRegion: sitio.direccion.provincia,
    postalCode: sitio.direccion.codigoPostal,
    addressCountry: sitio.direccion.pais,
  },
  geo: {
    "@type": "GeoCoordinates",
    latitude: sitio.coordenadas.lat,
    longitude: sitio.coordenadas.lng,
  },
  telephone: `+${sitio.contacto[id].whatsapp}`,
  parentOrganization: { "@type": "LocalBusiness", name: sitio.nombre, url: Astro.site?.href },
  ...(d.schema === "Restaurant"
    ? {
        servesCuisine: "Cocina de mar",
        ...(d.cartaUrl ? { hasMenu: d.cartaUrl } : {}),
        openingHoursSpecification: d.horarios.flatMap((h) =>
          h.franjas.map((f) => ({
            "@type": "OpeningHoursSpecification",
            dayOfWeek: h.dias.map(
              (n) =>
                ["Sunday", "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"][n],
            ),
            opens: f.desde,
            closes: f.hasta,
          })),
        ),
      }
    : {}),
};
---

<Base
  titulo={d.seo.titulo}
  descripcion={d.seo.descripcion}
  unidadActiva={u.id}
  datosEstructurados={datosEstructurados}
>
  <div class={`unidad u-${id}`}>
    <section class:list={["hero", d.heroVideo && "con-retrato"]} data-hero>
      <div class="fondo">
        <Foto
          foto={d.hero}
          unidad={id}
          ornamento={d.ornamento}
          pendiente={`Foto principal de ${d.nombre.toLowerCase()} pendiente`}
          variante="hero"
          prioridad
          sizes="100vw"
        />
      </div>
      <div class="marco-hero">
        <div class="texto sobre-foto">
          <div class="placa">
          {
            d.marca ? (
              <Image
                src={d.marca.src}
                alt={d.marca.alt}
                widths={[220, 440]}
                sizes="220px"
                class="marca"
                loading="eager"
              />
            ) : (
              <p class="etiqueta">{d.nombre}</p>
            )
          }
          <h1>{d.titular}</h1>
          <Estado estado={estado} unidad={id} class="estado-hero" />
          <div class="acciones">
            {
              ctas.map((c, i) => (
                <Boton href={c.href} jerarquia={i === 0 ? "primaria" : "secundaria"}>
                  {c.texto}
                </Boton>
              ))
            }
          </div>
          </div>
        </div>
        {
          d.heroVideo && (
            <HeroRetrato
              src={d.heroVideo.src}
              poster={d.heroVideo.poster}
              alt={d.heroVideo.alt}
            />
          )
        }
      </div>
    </section>

    <Onda />

    <section class="cuerpo banda-salvia">
      <div class="interior">
        <div class="relato">
          <Ornamento pieza={d.ornamento} class="fondo-orn" />
          {d.firma && <p class="firma">{d.firma}</p>}
          {d.intro.map((p) => <p class="parrafo">{p}</p>)}
          {d.fotoRelato && (
            <MarcoFoto
              foto={d.fotoRelato}
              proporcion="3/2"
              sizes="(min-width: 860px) 55vw, 100vw"
              class="foto-relato"
            />
          )}
        </div>
        <Ficha horarios={d.horarios} ficha={d.ficha} />
      </div>
    </section>

    {
      d.cartaUrl && (
        <section class={`bloque ${banda}`} data-revelar>
          <div class:list={["interior-simple", d.cartaFoto && "lado-foto foto-izq"]}>
            {d.cartaFoto && <MarcoFoto foto={d.cartaFoto} />}
            <div class="salida">
            <div>
              <div class="encabezado"><p class="rotulo">Para comer</p><h2>La carta</h2></div>
              <p class="nota">
                Cambia con la temporada y con lo que llega del puerto. Se abre en el
                celular, sin descargar nada.
              </p>
            </div>
            <Boton href={d.cartaUrl} externo>Ver la carta</Boton>
            </div>
          </div>
        </section>
      )
    }

    {
      d.listas.length > 0 && (
        <section class={`bloque ${banda}`} data-revelar>
          <div class:list={["interior-simple", d.listasFoto && "lado-foto"]}>
            <div class="listas">
            {d.listas.map((l) => (
              <div>
                <h2>{l.titulo}</h2>
                <ul class="lista">
                  {l.items.map((i) => <li>{i}</li>)}
                </ul>
              </div>
            ))}
            </div>
            {d.listasFoto && <MarcoFoto foto={d.listasFoto} />}
          </div>
        </section>
      )
    }

    {
      d.derivacion && (
        <section class={`derivacion ${banda}`} data-revelar>
          <div class:list={["interior-simple", d.derivacion.foto && "lado-foto foto-izq"]}>
            {d.derivacion.foto && <MarcoFoto foto={d.derivacion.foto} />}
            <div class="texto-derivacion">
            <div class="encabezado">
              <p class="rotulo">{d.derivacion.rotulo}</p>
              <h2>{d.derivacion.titulo}</h2>
            </div>
            <p class="parrafo">{d.derivacion.texto}</p>
            {d.derivacion.logo && (
              <Image
                src={d.derivacion.logo.src}
                alt={d.derivacion.logo.alt}
                widths={[240, 480]}
                sizes="240px"
                class="logo-marca"
                loading="lazy"
              />
            )}
            <Boton href={d.derivacion.url} externo>{d.derivacion.texto_cta}</Boton>
            </div>
          </div>
        </section>
      )
    }

    {
      d.video && (
        <section class="bloque banda-turquesa" data-revelar>
          <div class:list={["interior-simple", d.video.formato === "vertical" && "con-video-vertical"]}>
            <div class="encabezado"><p class="rotulo">El lugar</p><h2>{d.video.titulo}</h2></div>
            <Video
              src={d.video.src}
              poster={d.video.poster}
              titulo={d.video.titulo}
              descripcion={d.video.descripcion}
              vertical={d.video.formato === "vertical"}
            />
          </div>
        </section>
      )
    }

    {
      d.galeria.length > 0 && (
        <section class="bloque" data-revelar>
          <div class="interior-simple">
            <Galeria fotos={d.galeria} unidad={id} titulo="El lugar" />
          </div>
        </section>
      )
    }

    <Cruce excepto={u.id} />
  </div>

  {ctas[0] && <BarraFija texto={ctas[0].texto} href={ctas[0].href} />}
</Base>

<style>
  .u-restaurante { --u: var(--u-restaurante); --u-txt: var(--u-restaurante-txt); }
  .u-hotel { --u: var(--u-hotel); --u-txt: var(--u-hotel-txt); }
  .u-balneario { --u: var(--u-balneario); --u-txt: var(--u-balneario-txt); }
  .u-eventos { --u: var(--u-eventos); --u-txt: var(--u-eventos-txt); }

  .hero { position: relative; isolation: isolate; overflow: hidden; }
  /* Sin capas sobre la foto: se ve entera. El texto va en su placa. */

  .hero::after {
    content: "";
    position: absolute;
    inset: auto 0 0;
    height: 3px;
    background: var(--u);
  }
  .fondo { position: absolute; inset: 0; z-index: -2; background: var(--fondo-alt); }
  .fondo :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .fondo :global(.pendiente) { height: 100%; }

  /* Contenedor del hero. Sin video es una sola columna y el hero queda
     igual que siempre; con video se parte en dos. */
  .marco-hero {
    max-width: var(--ancho);
    margin-inline: auto;
    /* Arriba, lo que ocupa la cabecera, que va encima de la foto. */
    padding: calc(var(--alto-cabecera) + var(--paso-corto)) var(--margen) var(--paso-corto);
  }

  .texto {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: flex-end;
    gap: 1rem;
    /* El hero entero mide --alto-portada: el texto ocupa lo que dejan los
       rellenos del marco. */
    min-height: calc(var(--alto-portada) - var(--alto-cabecera) - 2 * var(--paso-corto));
    color: var(--sobre-oscuro);
  }

  /* El video vertical no se estira a pantalla completa: convive con el
     texto, al costado. Debajo de 860 px no se muestra. */
  .con-retrato .marco-hero {
    display: grid;
    gap: clamp(1.75rem, 4vw, 3.5rem);
    align-items: center;
  }
  .con-retrato :global(.retrato) { justify-self: center; }
  /* Apilado arriba del texto, el panel duplicaba el alto del hero y lo
     hacía distinto del resto de las páginas. En angosto no va: el video
     tampoco arrancaba ahí (ver HeroRetrato). */
  @media (max-width: 859px) {
    .con-retrato :global(.retrato) { display: none; }
  }
  @media (min-width: 860px) {
    .con-retrato .marco-hero { grid-template-columns: 1fr auto; }
    /* El panel mide lo mismo que el texto: el hero no crece por él. */
    .con-retrato :global(.retrato) {
      height: min(44rem, calc(var(--alto-portada) - var(--alto-cabecera) - 2 * var(--paso-corto)));
      width: auto;
    }
  }
  /* Cuando la unidad tiene marca propia, el logo ocupa el lugar del rótulo
     y con bastante más presencia: es el nombre de la casa, no una etiqueta. */
  .texto :global(.marca) {
    width: auto;
    height: clamp(4.5rem, 9vw, 7rem);
    object-fit: contain;
    margin-bottom: 0.5rem;
  }
  .etiqueta {
    font-size: var(--t-eyebrow);
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--verde-placa-texto);
  }
  .texto .placa {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1rem;
  }
  h1 { font-size: var(--t-portada); max-width: 18ch; }
  /* El texto sobre foto se lee siempre: gana el color claro, no el de
     cuerpo, que sobre el velo quedaba invisible. */
  .texto :global(.estado),
  .texto :global(.estado .detalle) { color: var(--sobre-oscuro); }
  .acciones { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 0.5rem; }
  /* El color de los botones lo pone .sobre-foto, no una regla suelta. */

  .cuerpo { padding: var(--paso) var(--margen) var(--paso-abajo); }
  .interior {
    display: grid;
    gap: clamp(2rem, 5vw, 4rem);
    max-width: var(--ancho);
    margin-inline: auto;
  }
  @media (min-width: 860px) {
    .interior { grid-template-columns: 1.55fr 1fr; }
  }

  .relato {
    position: relative;
    align-self: start;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }
  .relato :global(.fondo-orn) {
    position: absolute;
    right: -2%;
    bottom: -8%;
    width: 34%;
    max-width: 180px;
    color: var(--u-txt);
    z-index: -1;
  }
  .firma {
    font-family: var(--f-firma);
    font-style: italic;
    font-size: var(--t-h2);
    line-height: 1.2;
    max-width: 18ch;
    margin-bottom: 0.5rem;
  }
  .parrafo { max-width: var(--medida); }

  .bloque { padding: var(--paso) var(--margen) var(--paso-abajo); }
  .interior-simple { max-width: var(--ancho); margin-inline: auto; }

  .nota { color: var(--tinta-suave); max-width: var(--medida); }

  /* Bloque de texto con una foto al costado. La foto alterna de lado de un
     bloque al siguiente (foto-izq) para que la página no sea una columna
     de texto con fotos siempre a la derecha. En angosto se apilan. */
  .lado-foto {
    display: grid;
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: center;
  }
  @media (min-width: 860px) {
    .lado-foto { grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr); }
    .lado-foto.foto-izq { grid-template-columns: minmax(0, 1fr) minmax(0, 1.25fr); }
  }

  /* Video vertical: en ancho, el título a la izquierda y el video alto a la
     derecha; en angosto, uno debajo del otro, con el video centrado. */
  .con-video-vertical :global(.video.vertical) { display: flex; flex-direction: column; align-items: center; }
  @media (min-width: 860px) {
    .con-video-vertical {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: center;
      gap: clamp(2rem, 5vw, 4.5rem);
    }
    .con-video-vertical .encabezado { margin-bottom: 0; }
  }

  /* La foto de la introducción ocupa el hueco que deja al lado la ficha,
     que es más alta que el texto. */
  .relato :global(.foto-relato) { margin-top: 0.75rem; }

  /* Bloque que manda a otro lado: título a la izquierda, salida a la derecha. */
  .salida {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.75rem;
    border-top: 2px solid var(--linea-fuerte);
    padding-top: 1.75rem;
  }

  /* Un grupo de listas por fila; cada grupo, su título y sus fichas. */
  .listas {
    display: grid;
    gap: clamp(2.5rem, 5vw, 4rem);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr));
  }
  .listas h2 { margin-bottom: 1.25rem; }

  /* Los ítems son fichas, no renglones: en una columna de 1140 px una
     ficha por fila queda como una barra vacía. Se acomodan en varias. */
  .lista {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 15rem), 1fr));
    gap: 0.85rem;
  }
  .lista li {
    padding: 1.1rem 1.25rem;
    background: var(--superficie);
    border: 1px solid var(--borde-caja);
    border-radius: var(--radio);
    box-shadow: var(--elev-1);
    transition: transform var(--transicion), border-color var(--transicion);
  }
  @media (hover: hover) {
    .lista li:hover { transform: translateY(-3px); border-color: var(--u); }
  }
  @media (prefers-reduced-motion: reduce) {
    .lista li { transition: none; }
    .lista li:hover { transform: none; }
  }

  .derivacion {
    border-top: 1px solid var(--linea);
    padding: var(--paso) var(--margen) var(--paso-abajo);
  }
  /* Derivación y «también en el complejo» comparten material: pegadas,
     sus pasos verticales se sumaban. El corte lo marca el cambio de bloque,
     no el doble de aire. */
  .derivacion:has(+ :global(.cruce)) { padding-bottom: var(--paso-corto); }
  .derivacion + :global(.cruce) { padding-top: var(--paso-corto); }
  .texto-derivacion {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.25rem;
  }
  .derivacion .parrafo { color: var(--tinta-suave); }
  /* El logo de la marca a la que se deriva: chico, sin caja y sin
     competir con el botón, que es lo que hay que tocar. */
  .derivacion :global(.logo-marca) {
    width: auto;
    max-width: 14rem;
    max-height: 8rem;
    object-fit: contain;
    /* Ili Ili viene con fondo transparente y no se nota; Mar Eventos trae su
       cuadro crema, y ahí el radio lo pone en el mismo idioma que el resto. */
    border-radius: var(--radio-chico);
    margin-block: 0.5rem;
  }
</style>
