---
import { getCollection } from "astro:content";
import Base from "~/layouts/Base.astro";
import Onda from "~/components/Onda.astro";
import Puerta from "~/components/Puerta.astro";
import Foto from "~/components/Foto.astro";
import HeroVideo from "~/components/HeroVideo.astro";
import Boton from "~/components/Boton.astro";
import Confianza from "~/components/Confianza.astro";
import TiraFotos from "~/components/TiraFotos.astro";
import MarcoFoto from "~/components/MarcoFoto.astro";
import CierreCta from "~/components/CierreCta.astro";
import { estadoDeUnidad, agendaVigente } from "~/lib/estado";
import { datosSitio, waLink, wokiLink } from "~/lib/contacto";
import portada from "~/assets/fotos/complejo/predio-dron.jpg";
import portadaVertical from "~/assets/fotos/complejo/predio-dron-vertical.jpg";
import mar from "~/assets/fotos/complejo/mar-surfistas.jpg";

const sitio = await datosSitio();
const woki = await wokiLink();

const unidades = (await getCollection("unidades")).sort((a, b) => a.data.orden - b.data.orden);
const agenda = agendaVigente((await getCollection("agenda")).map((a) => a.data));

/* El horario del restaurante también manda en el home: es lo primero que
   pregunta quien busca dónde comer hoy. */
const restaurante = unidades.find((u) => u.id === "restaurante");
const horarios = restaurante?.data.horarios ?? [];
const rango = (f: { desde: string; hasta: string }) =>
  `${f.desde} a ${f.hasta === "23:59" ? "00:00" : f.hasta}`;

/** Cada puerta lleva su propio CTA al canal que corresponde. */
const puertas = await Promise.all(
  unidades.map(async (u) => {
    const primera = u.data.ctas[0];
    const href =
      primera.tipo === "woki" && woki
        ? woki
        : primera.tipo === "externo" && primera.href
          ? primera.href
          : await waLink(u.id as any);
    return {
      unidad: u,
      estado: estadoDeUnidad({
        horarios: u.data.horarios,
        temporada: u.data.temporada,
        estadoFijo: u.data.estadoFijo,
      }),
      cta: primera.textoCorto ?? primera.texto,
      ctaHref: href,
    };
  }),
);

/* La banda de fotos del home se arma sola: las dos primeras de la galería de
   cada unidad. Cargar una foto en un YAML la trae acá sin tocar esta página. */
const tira = unidades.flatMap((u, i) =>
  /* Tres de la primera y dos del resto: nueve fotos son una pieza grande
     más dos filas completas de cuatro, sin un hueco al final. */
  u.data.galeria.slice(0, i === 0 ? 3 : 2).map((foto) => ({
    foto,
    unidad: u.id as "restaurante" | "hotel" | "balneario" | "eventos",
    nombre: u.data.nombre,
  })),
);

const datosEstructurados = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  name: sitio.nombre,
  description: sitio.descripcion,
  url: Astro.site?.href,
  foundingDate: String(sitio.desde),
  address: {
    "@type": "PostalAddress",
    streetAddress: sitio.direccion.calle,
    addressLocality: sitio.direccion.localidad,
    addressRegion: sitio.direccion.provincia,
    postalCode: sitio.direccion.codigoPostal,
    addressCountry: sitio.direccion.pais,
  },
  geo: {
    "@type": "GeoCoordinates",
    latitude: sitio.coordenadas.lat,
    longitude: sitio.coordenadas.lng,
  },
  telephone: `+${sitio.contacto.general.whatsapp}`,
  department: unidades.map((u) => ({
    "@type": u.data.schema === "BeachResort" ? "LocalBusiness" : u.data.schema,
    name: u.data.nombreLargo,
    url: new URL(`/${u.id}`, Astro.site).href,
  })),
};
---

<Base
  titulo={sitio.nombre}
  descripcion={sitio.descripcion}
  datosEstructurados={datosEstructurados}
>
  <!-- Hero: el video ocupa toda la pantalla debajo de la cabecera, con el
       titular abajo a la izquierda. La onda cierra el primer pantallazo y
       las cuatro puertas empiezan en el primer scroll. -->
  <section class="hero" data-hero>
    <HeroVideo
      src="/video/waikiki-hero"
      poster={portada}
      posterVertical={portadaVertical}
      alt="El complejo Mirador Waikiki visto desde el mar con un dron: el restaurante, las piletas, el parque y la playa sobre la costa de Mar del Plata"
    />
    <div class="texto sobre-foto">
      <p class="eyebrow">
        {sitio.direccion.localidad} · desde {sitio.desde}
      </p>
      <h1>{sitio.lema}</h1>
      <p class="valor">
        Restaurante, hotel, balneario y salón de eventos en un mismo predio
        sobre las rocas, con bajada directa a la playa.
      </p>
    </div>
  </section>

  <Onda animada />

  <!-- Las cuatro puertas, en el primer scroll. Nadie atraviesa tres
       secciones de casamientos para reservar una mesa. -->
  <h2 class="vo">Las cuatro unidades del complejo</h2>
  <div class="puertas" data-revelar-grupo="4">
    {
      puertas.map((p, i) => (
        <Puerta
          id={p.unidad.id as any}
          nombre={p.unidad.data.nombre}
          bajada={p.unidad.data.bajada}
          href={`/${p.unidad.id}`}
          estado={p.estado}
          cta={p.cta}
          ctaHref={p.ctaHref}
          foto={p.unidad.data.hero}
          ornamento={p.unidad.data.ornamento}
          destacada={i === 0}
        />
      ))
    }
  </div>

  <!-- Un solo lugar -->
  <section class="relato banda-verde" data-revelar>
    <div class="interior">
      <div class="palabra">
        <p class="firma">{sitio.firma}</p>
        <p class="cuerpo">
          Un mismo predio sobre las rocas: se almuerza donde se veranea, se duerme donde
          se casa. Veintiséis años en el mismo lugar, con el mar siempre del mismo lado.
        </p>
        <Boton href={sitio.mapaUrl} jerarquia="secundaria" externo>Cómo llegar</Boton>
      </div>
      <figure>
        <Foto
          foto={{
            src: mar,
            alt: "El mar de Mar del Plata desde el aire, con surfistas esperando la ola en agua verde oscuro",
            foco: "centro",
          }}
          anchos={[500, 900, 1300]}
          sizes="(max-width: 900px) 100vw, 46vw"
        />
      </figure>
    </div>
  </section>

  <!-- Horarios: imagen y las dos líneas, nada más -->
  {
    horarios.length > 0 && restaurante && (
      <section class="horarios banda-turquesa" data-revelar>
        <figure>
          <Foto
            foto={restaurante.data.hero}
            unidad="restaurante"
            anchos={[420, 700, 1000]}
            sizes="(max-width: 900px) 100vw, 46vw"
          />
        </figure>
        <div class="texto-horarios">
          <div class="encabezado">
            <p class="rotulo">Restaurante</p>
            <h2>Abierto desde las ocho</h2>
          </div>
          <dl>
            {horarios.map((h) => (
              <div>
                <dt>{h.etiqueta}</dt>
                <dd>{h.franjas.map(rango).join(" · ")}</dd>
              </div>
            ))}
          </dl>
          <Boton href="/restaurante" jerarquia="secundaria">Ver el restaurante</Boton>
        </div>
      </section>
    )
  }

  <!-- La temporada ahora: el sitio sabe en qué mes está -->
  {
    agenda.length > 0 && (
      <section class="agenda">
        <div class="interior">
          <h2>Estos días en el complejo</h2>
          <ul>
            {agenda.map((a) => (
              <li class:list={["caja", `u-${a.unidad}`]}>
                <a href={`/${a.unidad}`}>
                  <b>{a.titulo}</b>
                  <span>{a.detalle}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  <TiraFotos items={tira} rotulo="El predio" titulo="Cuatro lugares, un mismo mar" />

  <Onda />

  <!-- Prueba social: lo que el patrón del plugin marcaba como faltante -->
  <Confianza />

  <!-- Cómo llegar -->
  <section class="llegar banda-turquesa-hondo" data-revelar>
    <div class="interior">
      <div>
        <div class="encabezado"><p class="rotulo">Cómo llegar</p><h2>Dónde estamos</h2></div>
        <address>
          {sitio.direccion.calle}<br />
          {sitio.direccion.localidad}, {sitio.direccion.provincia}
        </address>
        <ul class="indicaciones">
          {sitio.comoLlegar.map((i) => <li>{i}</li>)}
        </ul>
        <p class="estacionamiento">{sitio.estacionamiento}</p>
      </div>
      <div class="lado-llegar">
        <div class="acciones">
          <Boton href={sitio.mapaUrl} externo>
            Abrir en Google Maps
          </Boton>
          <Boton href="/contacto" jerarquia="secundaria">Teléfonos y contacto</Boton>
        </div>
        <MarcoFoto foto={sitio.fotos.llegar} proporcion="4/5" sizes="(min-width: 780px) 35vw, 100vw" />
      </div>
    </div>
  </section>

  <!-- CTA de cierre: el patrón lo pide después de la prueba social -->
  <CierreCta />
</Base>

<style>
  .hero { position: relative; isolation: isolate; overflow: hidden; }
  /* Una sola sombra, en la franja del texto: oscurece la izquierda y se
     apaga hacia la derecha y hacia arriba. El resto del cuadro queda
     limpio, que es lo que se tiene que ver.

     Es un degradado horizontal recortado por una máscara vertical: el
     producto de los dos da una esquina oscura abajo a la izquierda sin
     ningún borde visible. Va en el hero entero y no en la caja del texto:
     colgada del texto, el degradado no llegaba a transparente antes del
     borde de su caja y se veía un rectángulo recortado.

     Los valores salen de medir: el rótulo y la bajada son texto chico y
     piden 4,5 contra el pixel más claro del video que les pasa por
     detrás, en cualquier momento del recorrido. */
  .hero::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(
      to right,
      rgb(var(--velo) / var(--sombra-texto)) 0%,
      rgb(var(--velo) / var(--sombra-texto)) 46%,
      rgb(var(--velo) / 0.3) 60%,
      rgb(var(--velo) / 0) 76%
    );
    -webkit-mask-image: linear-gradient(to top, #000 0%, #000 var(--sombra-alto), transparent 88%);
    mask-image: linear-gradient(to top, #000 0%, #000 var(--sombra-alto), transparent 88%);
    pointer-events: none;
    --sombra-texto: 0.64;
    --sombra-alto: 50%;
  }
  /* En el celular el texto va de borde a borde y ocupa más alto: la sombra
     cubre todo el ancho y sube un poco más. */
  @media (max-width: 700px) {
    .hero::before {
      background: rgb(var(--velo) / var(--sombra-texto));
      /* La foto vertical tiene la espuma de las olas justo detrás del
         texto: pide más sombra que la horizontal, pero sólo en la franja
         de abajo. El cielo, el mar y el complejo quedan limpios. */
      --sombra-texto: 0.62;
      --sombra-alto: 44%;
    }
  }

  .texto {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    max-width: var(--ancho);
    /* Todo lo que queda de pantalla debajo de la cabecera, dejando a la
       vista la onda que cierra el hero.
       svh y no vh ni dvh: en el celular la barra del navegador cambia de
       alto al scrollear; con vh el hero queda más alto que la pantalla y
       con dvh salta mientras se scrollea. svh es el alto con la barra
       visible, fijo. La primera línea es la reserva sin svh. */
    min-height: calc(100vh - var(--alto-cabecera) - var(--alto-onda));
    min-height: calc(100svh - var(--alto-cabecera) - var(--alto-onda));
    margin-inline: auto;
    padding: var(--paso) var(--margen) var(--paso-corto);
    color: var(--sobre-oscuro);
  }

  .eyebrow {
    font-size: var(--t-eyebrow);
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    /* Sobre foto gana el color claro: el arena quedaba al límite. */
    color: var(--sobre-oscuro);
    margin-bottom: 0.9rem;
  }
  /* Más chico que el display del resto del sitio: acá manda el video. */
  h1 {
    font-size: clamp(2.25rem, 2.2vw + 1.4rem, 4rem);
    max-width: 16ch;
  }
  .valor {
    max-width: 44ch;
    margin-top: 1.25rem;
    color: var(--sobre-oscuro);
  }

  /* Bento, no catálogo. Cuatro columnas iguales aplanan la jerarquía y se
     leen como una grilla de plantilla; acá el restaurante ocupa la mitad
     izquierda entera y las otras tres se apilan al costado.

     Empieza debajo del hero, sin taparlo: el primer pantallazo es entero
     del video. */
  .puertas {
    position: relative;
    z-index: var(--z-base);
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(0.85rem, 1.5vw, 1.25rem);
    max-width: var(--ancho);
    margin-inline: auto;
    padding: var(--paso-corto) var(--margen);
  }
  @media (min-width: 900px) {
    .puertas {
      grid-template-columns: minmax(0, 1.08fr) minmax(0, 1fr);
      /* auto y no 1fr: con filas iguales las tres compactas se estiran a la
         altura de la grande y el botón queda flotando lejos del texto. */
      grid-template-rows: auto auto auto;
      align-items: start;
    }
    /* La destacada toma la columna izquierda entera. */
    .puertas > :global(.destacada) { grid-row: 1 / -1; height: 100%; }
  }

  .relato {
    background: var(--fondo-alt);
    border-block: 1px solid var(--linea);
    padding: var(--paso) var(--margen) var(--paso-abajo);
  }
  .relato .interior {
    display: grid;
    gap: clamp(2rem, 5vw, 4rem);
    max-width: var(--ancho);
    margin-inline: auto;
    align-items: center;
  }
  @media (min-width: 900px) {
    .relato .interior { grid-template-columns: 1fr 1fr; }
  }
  .palabra { display: flex; flex-direction: column; align-items: flex-start; gap: 1.5rem; }
  .firma {
    font-family: var(--f-firma);
    font-style: italic;
    font-size: var(--t-h2);
    line-height: 1.2;
    max-width: 16ch;
  }
  .cuerpo { max-width: var(--medida); color: var(--tinta-suave); }
  .relato figure { margin: 0; aspect-ratio: 4 / 3; overflow: hidden; border-radius: var(--radio-grande); box-shadow: var(--elev-2); }

  .horarios {
    display: grid;
    align-items: center;
    gap: clamp(2rem, 5vw, 4.5rem);
    max-width: var(--ancho);
    margin-inline: auto;
    padding: var(--paso) var(--margen) var(--paso-abajo);
  }
  @media (min-width: 900px) {
    .horarios { grid-template-columns: 1fr 1fr; }
  }
  .horarios figure {
    margin: 0;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-radius: var(--radio-grande);
    box-shadow: var(--elev-2);
  }
  .texto-horarios { display: flex; flex-direction: column; align-items: flex-start; }
  .texto-horarios dl { width: 100%; margin: 0 0 2.25rem; }
  .texto-horarios dl > div {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.2rem 1.5rem;
    padding: 1rem 0;
    border-bottom: 1px solid var(--linea);
  }
  .texto-horarios dl > div:first-child { border-top: 1px solid var(--linea); }
  .texto-horarios dt { font-size: 0.95rem; }
  .texto-horarios dd {
    margin: 0;
    font-size: 0.95rem;
    color: var(--acento);
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.04em;
  }

  .agenda { border-block: 1px solid var(--linea); padding: var(--paso-corto) var(--margen); }
  .agenda .interior { max-width: var(--ancho); margin-inline: auto; }
  .agenda h2 {
    font-family: var(--f-texto);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--tinta-suave);
    margin-bottom: 1.25rem;
  }
  .agenda ul {
    display: grid;
    gap: clamp(0.85rem, 1.6vw, 1.25rem);
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    list-style: none;
  }
  .agenda li { padding: 1.25rem 1.4rem; }
  .agenda li::before {
    content: "";
    position: absolute;
    inset: 0 auto 0 0;
    width: 3px;
    background: var(--u);
  }
  .agenda a { text-decoration: none; }
  .agenda b { display: block; font-weight: 600; }
  .agenda span { display: block; font-size: 0.925rem; color: var(--tinta-suave); }
  .agenda a:hover b { text-decoration: underline; }

  .u-restaurante { --u: var(--u-restaurante); }
  .u-hotel { --u: var(--u-hotel); }
  .u-balneario { --u: var(--u-balneario); }
  .u-eventos { --u: var(--u-eventos); }

  .llegar { padding: var(--paso) var(--margen) var(--paso-abajo); }
  .lado-llegar { display: flex; flex-direction: column; gap: 1.75rem; }
  .llegar .interior {
    display: grid;
    gap: clamp(1.75rem, 4vw, 3rem);
    max-width: var(--ancho);
    margin-inline: auto;
  }
  @media (min-width: 780px) {
    .llegar .interior { grid-template-columns: 1.4fr 1fr; align-items: start; }
  }

  address { font-style: normal; font-size: var(--t-guia); line-height: 1.5; }
  .indicaciones {
    list-style: none;
    margin-top: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    color: var(--tinta-suave);
  }
  .indicaciones li { padding-left: 1.1rem; position: relative; }
  .indicaciones li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.72em;
    width: 0.45rem;
    height: 1px;
    background: var(--tinta-suave);
  }
  .estacionamiento { margin-top: 1.25rem; color: var(--tinta-suave); }
  .acciones { display: flex; flex-direction: column; align-items: flex-start; gap: 0.85rem; }
</style>
