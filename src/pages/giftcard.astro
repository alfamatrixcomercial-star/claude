---
/**
 * Gift card · /giftcard
 *
 * NO se enlaza desde ninguna sección: ni el menú, ni el pie, ni el cruce
 * entre unidades. Se llega escribiendo la dirección. Además lleva noindex y
 * queda fuera del sitemap, porque si no Google la encuentra igual aunque no
 * haya un solo enlace apuntándole.
 *
 * El pago todavía no se hace acá. El formulario valida, arma el pedido y
 * abre WhatsApp con todo escrito: quien atiende recibe los datos completos
 * y coordina la transferencia. Cuando haya pasarela, lo único que cambia es
 * lo que pasa al apretar el botón; el formulario se queda igual.
 */
import Base from "~/layouts/Base.astro";
import { getCollection } from "astro:content";
import Onda from "~/components/Onda.astro";
import Foto from "~/components/Foto.astro";
import FondoFoto from "~/components/FondoFoto.astro";
import isologo from "~/assets/marca/isologo.svg?raw";
import { datosSitio } from "~/lib/contacto";

const sitio = await datosSitio();
const g = sitio.giftcard;
if (!g) throw new Error("Falta el bloque giftcard en sitio.yaml");

/* El número sale del contenido, como todos los demás. El texto del mensaje
   lo arma el navegador porque depende de lo que se escriba en el formulario. */
const whatsapp = sitio.contacto.general.whatsapp;

const unidades = [
  { valor: "Cualquiera del complejo", etiqueta: "Cualquiera del complejo" },
  { valor: "Restaurante", etiqueta: "Restaurante" },
  { valor: "Hotel Ili Ili", etiqueta: "Hotel Ili Ili" },
  { valor: "Balneario", etiqueta: "Balneario" },
];

/* «Para usar en»: una foto por unidad donde se puede usar la tarjeta. Salen
   de la foto principal de cada unidad, así cambian solas si cambia esa. */
const DONDE = ["restaurante", "hotel", "balneario"];
const usos = (await getCollection("unidades"))
  .filter((u) => DONDE.includes(u.id))
  .sort((a, b) => a.data.orden - b.data.orden);
---

<Base titulo={g.titulo} descripcion={g.bajada} noindex>
  <section class="portada banda-turquesa-hondo con-fondo portada-foto">
    <FondoFoto foto={g.foto} prioridad />
    <div class="interior sobre-foto">
      <div class="placa">
      <p class="rotulo">Gift card</p>
      <h1>{g.titulo}</h1>
      <p class="bajada">{g.bajada}</p>
      </div>
    </div>
  </section>

  <Onda />

  <section class="cuerpo" data-revelar>
    <div class="interior columnas">
      <div class="relato">
        <!-- La tarjeta de muestra. Se completa con lo que se escribe en el
             formulario: quien regala ve lo que va a recibir la otra
             persona. Repite lo que ya dice el formulario, así que para un
             lector de pantalla es ruido y va oculta. -->
        <div class="tarjeta" aria-hidden="true">
          <Foto foto={g.fotoTarjeta} sizes="(min-width: 960px) 30rem, 90vw" anchos={[480, 800, 1200]} />
          <div class="tarjeta-cuerpo">
            <div class="tarjeta-cabeza">
              <span class="tarjeta-logo" set:html={isologo} />
            </div>
            <div class="tarjeta-pie">
              <span class="tarjeta-rotulo">Gift card</span>
              <p class="tarjeta-para">Para <b data-vista="para" data-vacio="quien la reciba">quien la reciba</b></p>
              <p class="tarjeta-monto" data-vista="monto" data-vacio="El monto que elijas">El monto que elijas</p>
              <p class="tarjeta-mensaje" data-vista="mensaje" data-vacio="" hidden></p>
              <p class="tarjeta-de" data-vista-de hidden>De <span data-vista="de" data-vacio=""></span></p>
            </div>
          </div>
        </div>
        {g.intro.map((t) => <p class="parrafo">{t}</p>)}

        <ol class="pasos" data-revelar-grupo="3">
          {
            g.pasos.map((paso, i) => (
              <li>
                <span class="num">{i + 1}</span>
                <span class="paso-cuerpo">
                  <b>{paso.titulo}</b>
                  <span>{paso.texto}</span>
                </span>
              </li>
            ))
          }
        </ol>

        <div class="usos">
          <p class="usos-rotulo">Para usar en</p>
          <ul>
            {usos.map((u) => (
              <li>
                <Foto
                  foto={u.data.hero}
                  unidad={u.id as any}
                  ornamento={u.data.ornamento}
                  sizes="(min-width: 960px) 12rem, 30vw"
                  anchos={[320, 640]}
                />
                <span>{u.data.nombre}</span>
              </li>
            ))}
          </ul>
        </div>
        <p class="aviso"><b>Importante.</b> {g.aviso}</p>
      </div>

      <div class="bandeja marco-form">
        <div class="bandeja-nucleo">
          <form
            class="form"
            data-giftcard
            novalidate
            data-whatsapp={whatsapp}
            data-minimo={String(g.montoMinimo)}
          >
            <p class="form-titulo">Pedir la gift card</p>

            <div class="campo">
              <label for="de">Tu nombre</label>
              <input id="de" name="de" type="text" autocomplete="name" required
                maxlength="60" placeholder="Como querés que figure en la tarjeta" />
              <p class="error" id="e-de" hidden></p>
            </div>

            <div class="campo">
              <label for="email">Tu email</label>
              <input id="email" name="email" type="email" autocomplete="email"
                required maxlength="120" placeholder="Para mandarte el comprobante" />
              <p class="error" id="e-email" hidden></p>
            </div>

            <div class="campo">
              <label for="para">Nombre de quien la recibe</label>
              <input id="para" name="para" type="text" required maxlength="60" />
              <p class="error" id="e-para" hidden></p>
            </div>

            <div class="campo">
              <label for="emailPara">
                Email de quien la recibe <span class="opcional">opcional</span>
              </label>
              <input id="emailPara" name="emailPara" type="email" maxlength="120"
                placeholder="Si lo dejás vacío, te la mandamos a vos" />
              <p class="error" id="e-emailPara" hidden></p>
            </div>

            <div class="dos">
              <div class="campo">
                <label for="monto">Monto</label>
                <div class="con-signo">
                  <span aria-hidden="true">$</span>
                  <input id="monto" name="monto" type="text" inputmode="numeric"
                    required maxlength="12" placeholder="0" />
                </div>
                <p class="error" id="e-monto" hidden></p>
              </div>

              <div class="campo">
                <label for="unidad">Para usar en</label>
                <select id="unidad" name="unidad">
                  {unidades.map((u) => <option value={u.valor}>{u.etiqueta}</option>)}
                </select>
              </div>
            </div>

            <div class="campo">
              <label for="mensaje">
                Mensaje en la tarjeta <span class="opcional">opcional</span>
              </label>
              <textarea id="mensaje" name="mensaje" rows="3" maxlength="200"></textarea>
              <p class="contador"><span data-contador>0</span>/200</p>
            </div>

            <button type="submit" class="enviar">
              <span>Enviar el pedido por WhatsApp</span>
              <span class="disco" aria-hidden="true">
                <svg viewBox="0 0 16 12" width="13" height="10" focusable="false">
                  <path d="M0 6h12M8 1l5 5-5 5" fill="none" stroke="currentColor"
                    stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </span>
            </button>

            <p class="pie-form" role="status" data-estado></p>
          </form>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  /* Arriba, lo que ocupa la cabecera, que va encima de la foto. */
  .portada { padding: calc(var(--alto-cabecera) + var(--paso-corto)) var(--margen) var(--paso-corto); }
  .interior { max-width: var(--ancho); margin-inline: auto; }
  .portada h1 { margin-top: 0.6rem; max-width: 16ch; }
  .bajada {
    margin-top: 1.1rem;
    max-width: var(--medida);
    font-size: var(--t-guia);
    color: var(--sobre-oscuro);
  }

  .cuerpo { padding: var(--paso) var(--margen) var(--paso-abajo); }
  .columnas { display: grid; gap: clamp(2.5rem, 5vw, 4.5rem); align-items: start; }
  @media (min-width: 960px) {
    .columnas { grid-template-columns: minmax(0, 1fr) minmax(0, 27rem); }
  }

  .relato { display: flex; flex-direction: column; gap: 1.25rem; }

  /* ── La tarjeta de muestra ─────────────────────────────────────────────
     Proporción de tarjeta de verdad (la de una tarjeta de crédito), apenas
     inclinada, como apoyada sobre una mesa. Se endereza al pasar el mouse. */
  .tarjeta {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    width: min(100%, 30rem);
    aspect-ratio: 1.586;
    margin: 0.5rem 0 1.5rem 0.5rem;
    border-radius: 20px;
    box-shadow: var(--elev-4);
    color: var(--sobre-oscuro);
    transform: rotate(-2.5deg);
    transition: transform 700ms var(--curva);
  }
  .tarjeta:hover { transform: rotate(0deg) translateY(-4px); }
  .tarjeta :global(img) { position: absolute; inset: 0; z-index: -2; }
  /* La foto de la tarjeta, sin capa. Los datos van en una placa chica
     abajo y el logo arriba con una sombra propia: es una marca, no texto
     para leer, y así no hace falta oscurecer la foto para él. */
  /* El brillo de una tarjeta plastificada. */
  .tarjeta::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(115deg, rgb(255 255 255 / 0.16) 0%, rgb(255 255 255 / 0) 38%);
    pointer-events: none;
  }
  .tarjeta-cuerpo {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: clamp(1rem, 3vw, 1.35rem) clamp(1.1rem, 3.2vw, 1.5rem);
  }
  .tarjeta-cabeza { display: flex; align-items: center; justify-content: space-between; }
  .tarjeta-logo {
    display: flex;
    color: var(--sobre-oscuro);
    filter: drop-shadow(0 1px 6px rgb(2 18 16 / 0.55));
  }
  .tarjeta-logo :global(svg) { height: clamp(28px, 6vw, 38px); width: auto; }
  .tarjeta-rotulo {
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.24em;
    text-transform: uppercase;
  }
  .tarjeta-pie {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    width: fit-content;
    max-width: 100%;
    padding: 0.7rem 0.95rem 0.75rem;
    border-radius: 14px;
    background: rgb(235 228 209 / 0.9);
    -webkit-backdrop-filter: blur(14px) saturate(1.1);
    backdrop-filter: blur(14px) saturate(1.1);
    border: 1px solid rgb(255 255 255 / 0.6);
    color: var(--tinta);
  }
  @supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
    .tarjeta-pie { background: rgb(235 228 209 / 0.97); }
  }
  .tarjeta-pie .tarjeta-rotulo { margin-bottom: 0.2rem; }
  .tarjeta-para { font-size: 0.9rem; }
  .tarjeta-para b { font-weight: 600; }
  .tarjeta-monto {
    font-family: var(--f-display);
    font-size: clamp(1.5rem, 4.4vw, 2.1rem);
    font-weight: 600;
    line-height: 1.1;
    letter-spacing: -0.02em;
    font-variant-numeric: tabular-nums;
  }
  .tarjeta-mensaje {
    font-family: var(--f-firma);
    font-style: italic;
    font-size: 0.9rem;
    /* Un renglón: en la tarjeta el mensaje se insinúa, completo va en el mail. */
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .tarjeta-de { font-size: 0.8rem; }
  @media (prefers-reduced-motion: reduce) {
    .tarjeta, .tarjeta:hover { transform: none; transition: none; }
  }

  /* ── Para usar en ───────────────────────────────────────────────────── */
  .usos { margin-top: 1rem; }
  .usos-rotulo {
    font-size: var(--t-eyebrow);
    font-weight: 600;
    letter-spacing: var(--track-eyebrow);
    text-transform: uppercase;
    color: var(--tinta-suave);
    margin-bottom: 0.85rem;
  }
  .usos ul {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.75rem;
    max-width: 36rem;
  }
  .usos li { display: flex; flex-direction: column; gap: 0.5rem; }
  .usos li :global(img),
  .usos li :global(.pendiente) {
    aspect-ratio: 4 / 5;
    height: auto;
    border-radius: var(--radio);
    border: 1px solid var(--borde-caja);
    box-shadow: var(--elev-2);
  }
  .usos li span { font-size: 0.88rem; font-weight: 500; }
  .parrafo { max-width: var(--medida); }

  .pasos { list-style: none; display: flex; flex-direction: column; gap: 1rem; margin-top: 0.75rem; }
  .pasos li { display: flex; gap: 1rem; align-items: flex-start; }
  .num {
    display: grid;
    place-items: center;
    flex: none;
    width: 2rem;
    height: 2rem;
    border: 1px solid var(--borde-caja-activo);
    border-radius: 999px;
    font-size: 0.82rem;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    color: var(--acento);
  }
  .paso-cuerpo { display: flex; flex-direction: column; gap: 0.15rem; }
  .paso-cuerpo b { font-weight: 600; }
  .paso-cuerpo span { color: var(--tinta-suave); font-size: 0.94rem; }

  .aviso {
    margin-top: 0.75rem;
    padding: 1rem 1.15rem;
    max-width: var(--medida);
    background: var(--superficie);
    border: 1px solid var(--borde-caja);
    border-left: 3px solid var(--acento);
    border-radius: var(--radio-chico);
    font-size: 0.94rem;
    color: var(--tinta-suave);
  }
  .aviso b { color: var(--tinta); font-weight: 600; }

  /* ── Formulario ─────────────────────────────────────────────────────── */
  .marco-form { position: sticky; top: calc(var(--barra) + 1rem); }
  @media (max-width: 959px) { .marco-form { position: static; } }

  .form { display: flex; flex-direction: column; gap: 1.1rem; padding: 1.6rem 1.5rem 1.5rem; }
  .form-titulo {
    font-family: var(--f-ui);
    font-size: var(--t-eyebrow);
    font-weight: 600;
    letter-spacing: var(--track-eyebrow);
    text-transform: uppercase;
    color: var(--acento);
  }

  .campo { display: flex; flex-direction: column; gap: 0.4rem; }
  label { font-size: 0.86rem; font-weight: 500; }
  .opcional {
    font-weight: 400;
    font-size: 0.76rem;
    color: var(--tinta-suave);
    text-transform: lowercase;
  }

  input, select, textarea {
    width: 100%;
    min-height: var(--toque);
    padding: 0.6rem 0.85rem;
    font-family: inherit;
    font-size: 1rem;
    color: var(--tinta);
    background: var(--superficie-bisel);
    border: 1px solid var(--borde-caja);
    border-radius: var(--radio-chico);
    transition: border-color var(--transicion), background-color var(--transicion);
  }
  textarea { min-height: 5.5rem; resize: vertical; line-height: 1.5; }
  input:hover, select:hover, textarea:hover { border-color: var(--borde-caja-activo); }
  input:focus-visible, select:focus-visible, textarea:focus-visible {
    border-color: var(--acento);
    background: var(--superficie);
  }
  input::placeholder, textarea::placeholder { color: var(--tinta-suave); opacity: 0.75; }

  /* El signo va adentro del campo, no como prefijo suelto al lado. */
  .con-signo { position: relative; }
  .con-signo span {
    position: absolute;
    left: 0.85rem;
    top: 50%;
    translate: 0 -50%;
    color: var(--tinta-suave);
    pointer-events: none;
  }
  .con-signo input { padding-left: 1.85rem; font-variant-numeric: tabular-nums; }

  .dos { display: grid; gap: 1.1rem; }
  @media (min-width: 420px) { .dos { grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr); } }

  .error {
    font-size: 0.82rem;
    color: var(--error);
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }
  .error::before { content: "—"; opacity: 0.6; }
  /* El display: flex de arriba le gana al [hidden] del navegador: sin esto
     la caja vacía se dibuja igual y deja un guión suelto bajo cada campo. */
  .error[hidden] { display: none; }
  .campo:has(.error:not([hidden])) input,
  .campo:has(.error:not([hidden])) select { border-color: var(--error); }

  .contador {
    font-size: 0.76rem;
    color: var(--tinta-suave);
    text-align: right;
    font-variant-numeric: tabular-nums;
  }

  .enviar {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75em;
    margin-top: 0.4rem;
    min-height: var(--toque);
    padding: 0.5em 0.5em 0.5em 1.3em;
    font-family: var(--f-ui);
    font-size: 0.78rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accion-hover-tinta);
    background: var(--acento);
    border: 1px solid var(--acento);
    border-radius: 999px;
    transition: background-color var(--transicion), transform 160ms var(--curva);
  }
  .enviar .disco {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    flex: none;
    border-radius: 999px;
    background: rgb(0 0 0 / 0.12);
    transition: transform var(--transicion);
  }
  .enviar:hover .disco { transform: translate(3px, -1px) scale(1.06); }
  .enviar:active { transform: scale(0.98); }

  .pie-form { font-size: 0.86rem; color: var(--tinta-suave); }
  .pie-form:empty { display: none; }

  @media (prefers-reduced-motion: reduce) {
    .enviar, .enviar .disco, input, select, textarea { transition: none; }
    .enviar:hover .disco, .enviar:active { transform: none; }
  }
</style>

<script>
  import { enCadaPagina } from "~/lib/enCadaPagina";

  /* Con el router, este script corre una vez y queda vivo en las páginas
     siguientes: se engancha al formulario cada vez que aparece, y en las
     demás páginas no encuentra nada y no hace nada. */
  enCadaPagina(() => {
    const form = document.querySelector<HTMLFormElement>("form[data-giftcard]");
    if (!form) return;
    const wa = form.dataset.whatsapp!;
    const minimo = Number(form.dataset.minimo) || 0;
    const estado = form.querySelector<HTMLElement>("[data-estado]")!;

    const campo = (n: string) => form.querySelector<HTMLInputElement>(`#${n}`)!;
    const errorDe = (n: string) => form.querySelector<HTMLElement>(`#e-${n}`)!;

    const marcar = (n: string, texto: string | null) => {
      const caja = errorDe(n);
      const entrada = campo(n);
      caja.textContent = texto ?? "";
      caja.hidden = !texto;
      entrada.setAttribute("aria-invalid", texto ? "true" : "false");
      if (texto) entrada.setAttribute("aria-describedby", `e-${n}`);
      else entrada.removeAttribute("aria-describedby");
    };

    /* Sólo dígitos en el monto, formateados con puntos de mil mientras se
       escribe. Se guarda el número limpio aparte para validar y para el
       mensaje. */
    const monto = campo("monto");
    const soloNumero = (s: string) => s.replace(/\D/g, "");
    monto.addEventListener("input", () => {
      const limpio = soloNumero(monto.value);
      monto.value = limpio ? Number(limpio).toLocaleString("es-AR") : "";
    });

    const contador = form.querySelector<HTMLElement>("[data-contador]");
    const mensaje = form.querySelector<HTMLTextAreaElement>("#mensaje");
    if (contador && mensaje) {
      const actualizar = () => (contador.textContent = String(mensaje.value.length));
      mensaje.addEventListener("input", actualizar);
      actualizar();
    }

    /* La tarjeta de muestra copia lo que se va escribiendo. Lo vacío vuelve
       al texto de muestra (data-vacio), así nunca queda un hueco. */
    const tarjeta = document.querySelector<HTMLElement>(".tarjeta");
    const pintar = () => {
      if (!tarjeta) return;
      const poner = (n: string, texto: string) => {
        const el = tarjeta.querySelector<HTMLElement>(`[data-vista="${n}"]`);
        if (el) el.textContent = texto || el.dataset.vacio || "";
        return el;
      };
      poner("para", campo("para").value.trim());
      const importe = soloNumero(monto.value);
      poner("monto", importe ? `$ ${Number(importe).toLocaleString("es-AR")}` : "");
      const texto = (mensaje?.value ?? "").trim();
      const renglon = poner("mensaje", texto ? `“${texto}”` : "");
      if (renglon) renglon.hidden = !texto;
      const de = campo("de").value.trim();
      poner("de", de);
      const filaDe = tarjeta.querySelector<HTMLElement>("[data-vista-de]");
      if (filaDe) filaDe.hidden = !de;
    };
    form.addEventListener("input", pintar);
    pintar();

    /* Validación propia y no la del navegador: los mensajes nativos salen en
       el idioma del sistema y no se pueden escribir. */
    const emailValido = (v: string) => /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(v.trim());

    function revisar() {
      let primerError: string | null = null;
      const fallar = (n: string, texto: string) => {
        marcar(n, texto);
        primerError ??= n;
      };

      const de = campo("de").value.trim();
      de.length >= 2 ? marcar("de", null) : fallar("de", "Poné tu nombre.");

      const email = campo("email").value;
      emailValido(email) ? marcar("email", null) : fallar("email", "Revisá el email: falta el @ o el punto.");

      const para = campo("para").value.trim();
      para.length >= 2 ? marcar("para", null) : fallar("para", "Poné el nombre de quien la recibe.");

      const emailPara = campo("emailPara").value.trim();
      !emailPara || emailValido(emailPara)
        ? marcar("emailPara", null)
        : fallar("emailPara", "Ese email no parece válido.");

      const n = Number(soloNumero(monto.value));
      if (!n) fallar("monto", "Poné un monto.");
      else if (n < minimo)
        fallar("monto", `El mínimo es $${minimo.toLocaleString("es-AR")}.`);
      else marcar("monto", null);

      return primerError;
    }

    /* Revalida mientras se escribe, pero sólo si el campo ya se había
       marcado: corregir un error tiene que apagar el cartel enseguida, y a
       la vez nadie quiere que le griten antes de terminar de escribir.

       Al escribir y no al salir del campo: salir del último campo es
       apretar "Enviar", y si el cartel se apaga en ese momento el botón se
       corre hacia arriba entre que se aprieta y se suelta, y el clic se
       pierde. */
    for (const n of ["de", "email", "para", "emailPara", "monto"]) {
      campo(n).addEventListener("input", () => {
        if (!errorDe(n).hidden) revisar();
      });
    }

    form.addEventListener("submit", (e) => {
      e.preventDefault();
      const error = revisar();
      if (error) {
        estado.textContent = "Faltan datos. Mirá los campos marcados.";
        const entrada = campo(error);
        entrada.focus();
        entrada.scrollIntoView({ block: "center", behavior: "smooth" });
        return;
      }

      const v = (n: string) => campo(n).value.trim();
      const unidad = form.querySelector<HTMLSelectElement>("#unidad")!.value;
      const texto = form.querySelector<HTMLTextAreaElement>("#mensaje")!.value.trim();
      const importe = Number(soloNumero(monto.value)).toLocaleString("es-AR");

      const lineas = [
        "Hola! Quiero pedir una GIFT CARD de Mirador Waikiki.",
        "",
        `De parte de: ${v("de")}`,
        `Mi email: ${v("email")}`,
        `Para: ${v("para")}`,
        v("emailPara") ? `Email de quien la recibe: ${v("emailPara")}` : "La entrego yo",
        `Monto: $${importe}`,
        `Para usar en: ${unidad}`,
        texto ? `Mensaje en la tarjeta: "${texto}"` : null,
        "",
        "Quedo a la espera de los datos para transferir.",
      ].filter((l): l is string => l !== null);

      estado.textContent = "Abriendo WhatsApp con tu pedido…";
      window.open(
        `https://wa.me/${wa}?text=${encodeURIComponent(lineas.join("\n"))}`,
        "_blank",
        "noopener",
      );
    });
  });
</script>
