---
import "~/styles/base.css";
import Cabecera from "~/components/Cabecera.astro";
import Pie from "~/components/Pie.astro";
import { getImage } from "astro:assets";
import { ClientRouter } from "astro:transitions";
import Revelar from "~/components/Revelar.astro";
import portada from "~/assets/fotos/complejo/predio-dron.jpg";
import { datosSitio } from "~/lib/contacto";

interface Props {
  titulo: string;
  descripcion: string;
  unidadActiva?: string;
  /** JSON-LD ya armado por la página. Uno por página, sin plantillas. */
  datosEstructurados?: Record<string, unknown>;
  /** Fuera de Google. Para páginas que existen pero todavía no se publican. */
  noindex?: boolean;
}
const { titulo, descripcion, unidadActiva, datosEstructurados, noindex = false } = Astro.props;

const sitio = await datosSitio();
const url = new URL(Astro.url.pathname, Astro.site).href;
const og = await getImage({ src: portada, width: 1200, height: 630, format: "jpeg" });
const ogUrl = new URL(og.src, Astro.site).href;

const tituloCompleto =
  titulo === sitio.nombre ? `${sitio.nombre} · Mar del Plata` : `${titulo} · ${sitio.nombre}`;
---

<!doctype html>
<html lang="es-AR">
  <head>
    <!-- Marca que hay JS antes de que pinte nada, así el revelado por scroll
         puede esconder el contenido sin riesgo de dejar la página en blanco
         si el script no llega. Va primero adentro del head: entre <html> y
         <head> es posición inválida y el parser termina descartando la
         etiqueta. -->
    <script is:inline>
      document.documentElement.classList.add("js");
      /* Al navegar, el router copia los atributos del <html> de la página
         nueva, que viene del servidor sin la clase: hay que volver a
         ponerla o el revelado queda apagado desde el primer clic. Si el
         listener llegara a quedar duplicado no pasa nada: agregar una
         clase que ya está no cambia nada. */
      document.addEventListener("astro:after-swap", () =>
        document.documentElement.classList.add("js"),
      );
    </script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{tituloCompleto}</title>
    <meta name="description" content={descripcion} />
    <link rel="canonical" href={url} />
    {sitio.verificacion.google && (
      <meta name="google-site-verification" content={sitio.verificacion.google} />
    )}
    {sitio.verificacion.bing && (
      <meta name="msvalidate.01" content={sitio.verificacion.bing} />
    )}
    {sitio.verificacion.facebook && (
      <meta name="facebook-domain-verification" content={sitio.verificacion.facebook} />
    )}
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={sitio.nombre} />
    <meta property="og:locale" content="es_AR" />
    <meta property="og:title" content={tituloCompleto} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:url" content={url} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="El complejo Mirador Waikiki visto desde el mar con un dron, sobre la costa de Mar del Plata"
    />
    <meta name="twitter:card" content="summary_large_image" />

    <meta name="theme-color" content="#dbd2b5" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <ClientRouter />


    {
      datosEstructurados && (
        <script
          type="application/ld+json"
          is:inline
          set:html={JSON.stringify(datosEstructurados)}
        />
      )
    }
  </head>

  <body>
    <div class="grano" aria-hidden="true"></div>
    <Revelar />
    <!-- Persiste entre páginas: el script de abajo la agarra una sola vez
         y la necesita viva durante todo el cambio de página. -->
    <div class="cargando" aria-hidden="true" transition:persist="cargando"></div>
    <a class="saltar" href="#contenido">Saltar al contenido</a>
    <Cabecera unidadActiva={unidadActiva} />
    <main id="contenido">
      <slot />
    </main>
    <Pie />

    <script>
      /* La barra sólo se muestra si la navegación tarda: si la página ya
         está en caché, aparecer y desaparecer sería un parpadeo molesto. */
      const barra = document.querySelector<HTMLElement>(".cargando");
      let reloj: number | undefined;

      document.addEventListener("astro:before-preparation", () => {
        reloj = window.setTimeout(() => barra?.classList.add("activa"), 180);
      });
      document.addEventListener("astro:after-swap", () => {
        window.clearTimeout(reloj);
        if (!barra?.classList.contains("activa")) return;
        barra.classList.remove("activa");
        barra.classList.add("lista");
        window.setTimeout(() => barra.classList.remove("lista"), 460);
      });
    </script>
  </body>
</html>
