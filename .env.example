# Clave de API de Anthropic (Claude)
# Obtener en: https://console.anthropic.com/
ANTHROPIC_API_KEY=tu_clave_aqui

# Nombre de tu negocio (para personalizar respuestas)
BUSINESS_NAME=Mirador Waikiki

# Idioma de las respuestas (es = español, en = inglés)
RESPONSE_LANGUAGE=es

# Ruta al archivo de credenciales OAuth2 de Google
# Descargar desde Google Cloud Console
GOOGLE_CREDENTIALS_FILE=credentials.json

# (Opcional) Token guardado para no volver a autenticar cada vez
GOOGLE_TOKEN_FILE=token.json
